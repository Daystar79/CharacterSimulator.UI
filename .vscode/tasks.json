{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/CharacterSimulator.UI.sln",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "🔥 Watch & Hot Reload GUI (XAML & C#)",
      "command": "dotnet",
      "type": "process",
      "args": [
        "watch",
        "run",
        "--project",
        "${workspaceFolder}/CharacterSimulator.GUI/CharacterSimulator.GUI.csproj"
      ],
      "problemMatcher": "$msCompile"
    }
  ]
}
