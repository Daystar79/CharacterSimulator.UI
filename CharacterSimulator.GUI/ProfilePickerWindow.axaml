<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CharacterSimulator.GUI.ProfilePickerWindow"
        Title="Select User Profile — Character Simulator Studio"
        Width="540" Height="480"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        Background="#0F172A">

    <Border Padding="20">
        <DockPanel LastChildFill="True">
            
            <!-- HEADER -->
            <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,16">
                <DockPanel LastChildFill="True">
                    <TextBlock Text="👤 SELECT YOUR PROFILE" FontSize="16" FontWeight="Bold" Foreground="#38BDF8"/>
                    <TextBlock Text="Multi-User Profile System" FontSize="11" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock Text="Choose an existing user profile or create a new profile below." FontSize="11" Foreground="#94A3B8"/>
                <Separator Background="#334155" Margin="0,4"/>
            </StackPanel>

            <!-- ACTION BUTTONS BELOW -->
            <Border DockPanel.Dock="Bottom" Background="#1E293B" Padding="12" CornerRadius="8" Margin="0,16,0,0">
                <DockPanel LastChildFill="True">
                    <Button Name="BtnCreateProfile" Content="➕ New Profile..." Background="#2563EB" Foreground="White" FontWeight="Bold" Padding="14,7" CornerRadius="6" Click="OnCreateProfileClicked"/>
                    <Button Name="BtnUnlock" Content="🔓 Select &amp; Unlock" Background="#16A34A" Foreground="White" FontWeight="Bold" Padding="16,7" CornerRadius="6" HorizontalAlignment="Right" Click="OnSelectProfileClicked"/>
                </DockPanel>
            </Border>

            <!-- MAIN CONTENT: PROFILE LIST & PIN PROMPT -->
            <Grid RowDefinitions="*,Auto" Margin="0,4">
                
                <!-- PROFILE SELECTION LIST -->
                <Border Grid.Row="0" Background="#1E293B" CornerRadius="8" Padding="8" BorderBrush="#334155" BorderThickness="1">
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Top" Text="AVAILABLE USER PROFILES:" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="4,0,0,6"/>
                        <ListBox Name="ListProfiles" Background="Transparent" SelectionChanged="OnProfileSelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8" CornerRadius="6" Background="#0F172A" Margin="0,2">
                                        <DockPanel LastChildFill="True">
                                            <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding AgeText}" FontSize="10" Foreground="#38BDF8" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding AdultStatusText}" FontSize="9" Foreground="#94A3B8" HorizontalAlignment="Right"/>
                                            </StackPanel>
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC"/>
                                                <TextBlock Text="{Binding LastPlayedText}" FontSize="10" Foreground="#64748B"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- PIN ENTRY ROW (IF PROFILE HAS A PIN) -->
                <StackPanel Name="PanelPinPrompt" Grid.Row="1" Spacing="6" Margin="0,12,0,0" IsVisible="False">
                    <TextBlock Text="🔒 ENTER PROFILE PIN:" FontSize="11" FontWeight="Bold" Foreground="#F59E0B"/>
                    <TextBox Name="TxtPinInput" PasswordChar="•" Watermark="Enter security PIN..." Height="36" VerticalContentAlignment="Center"/>
                </StackPanel>

            </Grid>

        </DockPanel>
    </Border>
</Window>
