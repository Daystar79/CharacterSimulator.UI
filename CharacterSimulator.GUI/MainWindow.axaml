<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CharacterSimulator.GUI"
        mc:Ignorable="d" d:DesignWidth="1360" d:DesignHeight="880"
        x:Class="CharacterSimulator.GUI.MainWindow"
        Title="Character Simulator Studio (RPG &amp; Visual Novel Studio)"
        Width="1360" Height="880"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A">

    <DockPanel LastChildFill="True">
        
        <!-- 1. TOP MENU BAR (FILE, SIMULATION, VIEW) -->
        <Border DockPanel.Dock="Top" Background="#0F172A" BorderBrush="#334155" BorderThickness="0,0,0,1">
            <Menu Background="Transparent">
                <MenuItem Header="📁 File" Foreground="#F8FAFC">
                    <MenuItem Header="⚙️ Simulation Setup..." Click="OnOpenSetupClicked"/>
                    <Separator/>
                    <MenuItem Header="💾 Save Session" Click="OnSaveSessionClicked"/>
                    <MenuItem Header="📂 Load Session..." Click="OnLoadSessionClicked"/>
                    <Separator/>
                    <MenuItem Header="↺ Reset Stage" Click="OnResetClicked"/>
                </MenuItem>
                <MenuItem Header="🎮 Mode" Foreground="#F8FAFC">
                    <MenuItem Header="🤖 Auto-Play Mode" Click="OnSetAutoPlayMode"/>
                    <MenuItem Header="🎮 Player-Guided Mode" Click="OnSetPlayerGuidedMode"/>
                </MenuItem>
            </Menu>
        </Border>

        <!-- 2. COMPACT PLAYBACK TOOLBAR -->
        <Border DockPanel.Dock="Top" Background="#1E293B" Padding="12,6" BorderBrush="#334155" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                
                <!-- Left: App Title & Status Badge -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border CornerRadius="6" Background="#2563EB" Width="28" Height="28">
                        <TextBlock Text="🎭" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="CHARACTER SIMULATOR" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                    <Border Name="BadgeStatus" Background="#065F46" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                        <TextBlock Name="TxtBadgeStatus" Text="● READY" FontSize="9" FontWeight="Bold" Foreground="#34D399"/>
                    </Border>
                </StackPanel>

                <!-- Right: Playback Buttons Strip & Speed Controls -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    
                    <!-- Playback Buttons Strip -->
                    <Border Background="#0F172A" CornerRadius="6" Padding="3" BorderBrush="#475569" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button Name="BtnPlay" Content="▶ Play" Background="#16A34A" Foreground="White" FontWeight="Bold" Padding="10,5" CornerRadius="4" Click="OnPlayClicked"/>
                            <Button Name="BtnPause" Content="⏸ Pause" Background="#D97706" Foreground="White" FontWeight="Bold" Padding="10,5" CornerRadius="4" IsEnabled="False" Click="OnPauseClicked"/>
                            <Button Name="BtnStep" Content="⏭ Step" Background="#2563EB" Foreground="White" FontWeight="Bold" Padding="10,5" CornerRadius="4" Click="OnStepClicked"/>
                            <Button Name="BtnStop" Content="⏹ Stop" Background="#DC2626" Foreground="White" FontWeight="Bold" Padding="10,5" CornerRadius="4" IsEnabled="False" Click="OnStopClicked"/>
                        </StackPanel>
                    </Border>

                    <Separator Width="1" Height="18" Background="#475569" Margin="4,0"/>

                    <!-- Speed Slider -->
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="⚡ Delay:" FontSize="10" Foreground="#94A3B8" VerticalAlignment="Center"/>
                        <TextBlock Name="TxtDelayVal" Text="600ms" FontSize="10" Foreground="#F59E0B" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Slider Name="SliderDelay" Width="80" Minimum="100" Maximum="3000" Value="600" ValueChanged="OnDelaySliderChanged" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- Center Mode Badge & Active Scene -->
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="#0F172A" CornerRadius="4" Padding="8,3" BorderBrush="#3B82F6" BorderThickness="1">
                        <TextBlock Name="TxtActiveMode" Text="🤖 Auto-Play" FontSize="10" FontWeight="Bold" Foreground="#60A5FA"/>
                    </Border>
                    <Border Background="#0F172A" CornerRadius="4" Padding="8,3" BorderBrush="#10B981" BorderThickness="1">
                        <TextBlock Name="TxtActiveLlm" Text="⚡ Agent A: Mock | Agent B: Mock" FontSize="10" FontWeight="Bold" Foreground="#34D399"/>
                    </Border>
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="📍 SCENE:" FontSize="10" FontWeight="Bold" Foreground="#F59E0B"/>
                        <TextBlock Name="TxtActiveScene" Text="[Contemporary] Quiet city apartment..." FontSize="10" Foreground="#E2E8F0" MaxWidth="320" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>

            </DockPanel>
        </Border>

        <!-- 3. BOTTOM STATUS BAR -->
        <Border DockPanel.Dock="Bottom" Background="#1E293B" Padding="16,6" BorderBrush="#334155" BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Right" Text=".NET 10.0 • RPG Studio" FontSize="11" Foreground="#64748B"/>
                <TextBlock Name="TxtStatus" Text="Ready. Click File ➔ Simulation Setup to configure characters." FontSize="11" Foreground="#94A3B8"/>
            </DockPanel>
        </Border>

        <!-- 4. MAIN WORKSPACE (RESIZABLE 3-COLUMN WORKSPACE WITH GRID SPLITTERS) -->
        <Grid ColumnDefinitions="300,6,*,6,320" Margin="12">
            
            <!-- COLUMN 0: LEFT SIDEBAR (CANVAS & CONSOLE TOOLS) -->
            <Border Grid.Column="0" Background="#1E293B" CornerRadius="12" Padding="12" BorderBrush="#334155" BorderThickness="1">
                <TabControl VerticalAlignment="Stretch">
                    
                    <!-- TAB 1: CANVAS (LIVE SPEAKER PORTRAIT FRAME) -->
                    <TabItem Header="🖼️ Image Canvas">
                        <DockPanel LastChildFill="True" Margin="0,8,0,0">
                            <TextBlock DockPanel.Dock="Top" Text="ACTIVE SPEAKER PORTRAIT FRAME" FontSize="11" FontWeight="Bold" Foreground="#F59E0B" Margin="0,0,0,8"/>
                            <TextBlock DockPanel.Dock="Bottom" Text="IMAGE GENERATION PROMPT:" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Margin="0,8,0,4"/>
                            <Border DockPanel.Dock="Bottom" Background="#0F172A" CornerRadius="6" Padding="8">
                                <TextBlock Name="TxtImagePrompt" Text="No active image prompt." FontSize="10" Foreground="#FDE047" TextWrapping="Wrap"/>
                            </Border>
                            <Border Background="#0F172A" CornerRadius="8" Padding="4" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" ClipToBounds="True">
                                <Grid>
                                    <Image Name="ImgCanvasFrame" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Name="TxtCanvasPlaceholder" Text="[IMAGE CANVAS READY]" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DockPanel>
                    </TabItem>

                    <!-- TAB 2: CONSOLE -->
                    <TabItem Header="💻 Agent Console">
                        <DockPanel LastChildFill="True" Margin="0,8,0,0">
                            <TextBlock DockPanel.Dock="Top" Text="RAW LLM STDOUT STREAMS" FontSize="10" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,6"/>
                            <ScrollViewer Name="ScrollConsole" VerticalScrollBarVisibility="Auto" Background="#020617" Padding="8" CornerRadius="6">
                                <SelectableTextBlock Name="TxtAgentConsole" Text="[SYSTEM] Console ready." FontFamily="Consolas, Monospace" FontSize="10" Foreground="#34D399" TextWrapping="Wrap"/>
                            </ScrollViewer>
                        </DockPanel>
                    </TabItem>

                </TabControl>
            </Border>

            <!-- COLUMN 1: LEFT-CENTER RESIZABLE GRID SPLITTER -->
            <GridSplitter Grid.Column="1" Width="6" Background="Transparent" ResizeDirection="Columns" HorizontalAlignment="Stretch"/>

            <!-- COLUMN 2: CENTER VN DIALOGUE FEED & UNIFIED PLAYER INPUT CONSOLE BELOW -->
            <Border Grid.Column="2" Background="#0F172A" CornerRadius="12" BorderBrush="#334155" BorderThickness="1">
                <DockPanel LastChildFill="True">
                    
                    <!-- UNIFIED PLAYER INPUT CONSOLE (RPG CHOICES + DYNAMIC ROLE DROPDOWN) -->
                    <Border DockPanel.Dock="Bottom" Background="#1E293B" Padding="14" CornerRadius="0,0,12,12" BorderBrush="#334155" BorderThickness="0,1,0,0">
                        <StackPanel Spacing="10">
                            
                            <!-- Section 1: RPG Quick Choice Buttons -->
                            <DockPanel LastChildFill="True">
                                <TextBlock DockPanel.Dock="Left" Text="🎮 RPG ACTION CHOICES:" FontSize="11" FontWeight="Bold" Foreground="#F59E0B"/>
                                <TextBlock Text="Click to execute action" FontSize="10" Foreground="#64748B" HorizontalAlignment="Right"/>
                            </DockPanel>

                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
                                <Button Name="BtnRpgOpt1" Grid.Row="0" Grid.Column="0" Content="🗣️ Option 1: Ask for intel" Background="#0F172A" Foreground="#93C5FD" FontSize="11" Padding="10,7" Margin="0,0,4,4" CornerRadius="6" HorizontalAlignment="Stretch" Click="OnRpgOpt1Clicked"/>
                                <Button Name="BtnRpgOpt2" Grid.Row="0" Grid.Column="1" Content="🎭 Option 2: Inspect area" Background="#0F172A" Foreground="#A7F3D0" FontSize="11" Padding="10,7" Margin="4,0,0,4" CornerRadius="6" HorizontalAlignment="Stretch" Click="OnRpgOpt2Clicked"/>
                                <Button Name="BtnRpgOpt3" Grid.Row="1" Grid.Column="0" Content="🎯 Option 3: Execute Goal" Background="#0F172A" Foreground="#FDE047" FontSize="11" Padding="10,7" Margin="0,4,4,0" CornerRadius="6" HorizontalAlignment="Stretch" Click="OnRpgOpt3Clicked"/>
                                <Button Name="BtnRpgOpt4" Grid.Row="1" Grid.Column="1" Content="🎲 Option 4: Skill Check" Background="#0F172A" Foreground="#F472B6" FontSize="11" Padding="10,7" Margin="4,4,0,0" CornerRadius="6" HorizontalAlignment="Stretch" Click="OnRpgOpt4Clicked"/>
                            </Grid>

                            <Separator Background="#334155"/>

                            <!-- Section 2: Custom Text Intervention Bar (Dynamic Role Selector) -->
                            <DockPanel LastChildFill="True">
                                <TextBlock DockPanel.Dock="Left" Text="💬 CUSTOM INTERVENTION / DIALOGUE INPUT:" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                                <TextBlock Text="Press Enter to send" FontSize="10" Foreground="#64748B" HorizontalAlignment="Right"/>
                            </DockPanel>

                            <Grid ColumnDefinitions="160,*,110">
                                <ComboBox Name="ComboUserRole" Grid.Column="0" HorizontalAlignment="Stretch" Margin="0,0,8,0"/>
                                <TextBox Name="TxtUserInput" Grid.Column="1" PlaceholderText="Dialogue to characters, or /help for commands (slash cmds never go to the cast)..." KeyDown="OnUserInputKeyDown" Height="36" VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                                <Button Name="BtnSendInput" Grid.Column="2" Content="💬 Send" Background="#2563EB" Foreground="White" FontWeight="Bold" Height="36" CornerRadius="6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnSendInputClicked"/>
                            </Grid>

                        </StackPanel>
                    </Border>

                    <!-- Scrollable Visual Novel Dialogue Feed Output (CLEAN DIALOGUE WITHOUT SYSTEM METADATA) -->
                    <ScrollViewer Name="ScrollDialogue" VerticalScrollBarVisibility="Auto" Padding="16">
                        <ItemsControl Name="ItemsDialogueFeed">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="local:DialogueMessageModel">
                                    <Border Margin="0,0,0,12" Padding="12" CornerRadius="10" Background="{Binding SpeakerBg}" BorderBrush="{Binding SpeakerColor}" BorderThickness="1">
                                        <Grid RowDefinitions="Auto,Auto">
                                            
                                            <!-- Speaker Name Header with Avatar Portrait and Emotion -->
                                            <DockPanel Grid.Row="0" LastChildFill="True">
                                                <Border DockPanel.Dock="Right" Background="#0F172A" CornerRadius="4" Padding="6,2">
                                                    <TextBlock Text="{Binding SpeakerEmotionEmoji}" FontSize="11" VerticalAlignment="Center"/>
                                                </Border>
                                                
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Border CornerRadius="14" Width="28" Height="28" ClipToBounds="True" Background="#0F172A" VerticalAlignment="Center">
                                                        <Image Source="{Binding SpeakerBitmap}" Stretch="UniformToFill"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding SpeakerName}" FontSize="13" FontWeight="Bold" Foreground="{Binding SpeakerColor}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="➔" FontSize="10" Foreground="#64748B" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding TargetName}" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DockPanel>

                                            <!-- Pure Clean Character Dialogue Text -->
                                            <TextBlock Grid.Row="1" Text="{Binding Dialogue}" FontSize="13" Foreground="#F8FAFC" TextWrapping="Wrap" Margin="0,8,0,2" LineHeight="18"/>

                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- COLUMN 3: CENTER-RIGHT RESIZABLE GRID SPLITTER -->
            <GridSplitter Grid.Column="3" Width="6" Background="Transparent" ResizeDirection="Columns" HorizontalAlignment="Stretch"/>

            <!-- COLUMN 4: RIGHT SIDEBAR (BOTH CHARACTER CARDS A & B WITH LIVE PORTRAITS & TELEMETRY) -->
            <Border Grid.Column="4" Background="#1E293B" CornerRadius="12" Padding="14" BorderBrush="#334155" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="14">
                        
                        <!-- CHARACTER A CARD WITH PORTRAIT -->
                        <Border Background="#0F172A" CornerRadius="10" Padding="12" BorderBrush="#38BDF8" BorderThickness="1.5">
                            <StackPanel Spacing="10">
                                
                                <!-- PORTRAIT IMAGE -->
                                <Border CornerRadius="8" ClipToBounds="True" Background="#1E293B" Height="150">
                                    <Image Name="ImgCharAPortrait" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <DockPanel LastChildFill="True">
                                    <Border DockPanel.Dock="Left" CornerRadius="18" Width="36" Height="36" Background="#0284C7" Margin="0,0,8,0">
                                        <TextBlock Name="TxtCharAEmoji" Text="😐" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <DockPanel LastChildFill="True">
                                            <Border DockPanel.Dock="Right" Background="#1E293B" CornerRadius="4" Padding="5,1">
                                                <TextBlock Name="TxtCharAEmotion" Text="Neutral" FontSize="9" FontWeight="Bold" Foreground="#38BDF8"/>
                                            </Border>
                                            <TextBlock Name="TxtCharAName" Text="Serena" FontSize="15" FontWeight="Bold" Foreground="#38BDF8"/>
                                        </DockPanel>
                                        <TextBlock Name="TxtCharAState" Text="State: DORMANT" FontSize="10" Foreground="#94A3B8"/>
                                        <TextBlock Name="TxtCharALlm" Text="🤖 Agent: Mock" FontSize="9" FontWeight="Bold" Foreground="#38BDF8"/>
                                    </StackPanel>
                                </DockPanel>

                                <Separator Background="#334155"/>

                                <!-- Health & Energy Bars -->
                                <Grid ColumnDefinitions="*,*" Margin="0,2">
                                    <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,4,0">
                                        <DockPanel LastChildFill="True">
                                            <TextBlock Text="Health" FontSize="9" Foreground="#CBD5E1"/>
                                            <TextBlock Name="TxtCharAHealth" DockPanel.Dock="Right" Text="100%" FontSize="9" Foreground="#34D399" FontWeight="Bold"/>
                                        </DockPanel>
                                        <ProgressBar Name="ProgressCharAHealth" Height="6" Minimum="0" Maximum="100" Value="100" Foreground="#34D399" Background="#1E293B" CornerRadius="3"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Spacing="2" Margin="4,0,0,0">
                                        <DockPanel LastChildFill="True">
                                            <TextBlock Text="Energy" FontSize="9" Foreground="#CBD5E1"/>
                                            <TextBlock Name="TxtCharAEnergy" DockPanel.Dock="Right" Text="100%" FontSize="9" Foreground="#F59E0B" FontWeight="Bold"/>
                                        </DockPanel>
                                        <ProgressBar Name="ProgressCharAEnergy" Height="6" Minimum="0" Maximum="100" Value="100" Foreground="#F59E0B" Background="#1E293B" CornerRadius="3"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Bond Gauge -->
                                <StackPanel Spacing="4">
                                    <DockPanel LastChildFill="True">
                                        <TextBlock Text="Bond Meter" FontSize="10" Foreground="#CBD5E1"/>
                                        <TextBlock Name="TxtCharABond" DockPanel.Dock="Right" Text="0" FontSize="10" FontWeight="Bold" Foreground="#38BDF8"/>
                                    </DockPanel>
                                    <ProgressBar Name="ProgressCharABond" Height="8" Minimum="-50" Maximum="50" Value="0" Foreground="#38BDF8" Background="#1E293B" CornerRadius="4"/>
                                </StackPanel>

                                <!-- Somatic Zones -->
                                <TextBlock Text="Somatic Zones:" FontSize="10" Foreground="#94A3B8" FontWeight="SemiBold"/>
                                <Border Background="#1E293B" CornerRadius="6" Padding="8">
                                    <TextBlock Name="TxtCharASomatic" Text="Calm / None" FontSize="10" Foreground="#E2E8F0" TextWrapping="Wrap"/>
                                </Border>

                                <!-- Active Goals -->
                                <TextBlock Text="Active Goals:" FontSize="10" Foreground="#94A3B8" FontWeight="SemiBold"/>
                                <ItemsControl Name="ItemsCharAGoals">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="local:GoalViewModel">
                                            <Border Background="#1E293B" CornerRadius="4" Padding="6" Margin="0,0,0,4">
                                                <TextBlock Text="{Binding Title}" FontSize="10" FontWeight="Bold" Foreground="#F59E0B"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- CHARACTER B CARD WITH PORTRAIT -->
                        <Border Name="CardCharB" Background="#0F172A" CornerRadius="10" Padding="12" BorderBrush="#F43F5E" BorderThickness="1.5">
                            <StackPanel Spacing="10">
                                
                                <!-- PORTRAIT IMAGE -->
                                <Border CornerRadius="8" ClipToBounds="True" Background="#1E293B" Height="150">
                                    <Image Name="ImgCharBPortrait" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <DockPanel LastChildFill="True">
                                    <Border DockPanel.Dock="Left" CornerRadius="18" Width="36" Height="36" Background="#E11D48" Margin="0,0,8,0">
                                        <TextBlock Name="TxtCharBEmoji" Text="😐" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <DockPanel LastChildFill="True">
                                            <Border DockPanel.Dock="Right" Background="#1E293B" CornerRadius="4" Padding="5,1">
                                                <TextBlock Name="TxtCharBEmotion" Text="Neutral" FontSize="9" FontWeight="Bold" Foreground="#F43F5E"/>
                                            </Border>
                                            <TextBlock Name="TxtCharBName" Text="Kira" FontSize="15" FontWeight="Bold" Foreground="#F43F5E"/>
                                        </DockPanel>
                                        <TextBlock Name="TxtCharBState" Text="State: DORMANT" FontSize="10" Foreground="#94A3B8"/>
                                        <TextBlock Name="TxtCharBLlm" Text="🤖 Agent: Mock" FontSize="9" FontWeight="Bold" Foreground="#F43F5E"/>
                                    </StackPanel>
                                </DockPanel>

                                <Separator Background="#334155"/>

                                <!-- Health & Energy Bars -->
                                <Grid ColumnDefinitions="*,*" Margin="0,2">
                                    <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,4,0">
                                        <DockPanel LastChildFill="True">
                                            <TextBlock Text="Health" FontSize="9" Foreground="#CBD5E1"/>
                                            <TextBlock Name="TxtCharBHealth" DockPanel.Dock="Right" Text="100%" FontSize="9" Foreground="#34D399" FontWeight="Bold"/>
                                        </DockPanel>
                                        <ProgressBar Name="ProgressCharBHealth" Height="6" Minimum="0" Maximum="100" Value="100" Foreground="#34D399" Background="#1E293B" CornerRadius="3"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Spacing="2" Margin="4,0,0,0">
                                        <DockPanel LastChildFill="True">
                                            <TextBlock Text="Energy" FontSize="9" Foreground="#CBD5E1"/>
                                            <TextBlock Name="TxtCharBEnergy" DockPanel.Dock="Right" Text="100%" FontSize="9" Foreground="#F59E0B" FontWeight="Bold"/>
                                        </DockPanel>
                                        <ProgressBar Name="ProgressCharBEnergy" Height="6" Minimum="0" Maximum="100" Value="100" Foreground="#F59E0B" Background="#1E293B" CornerRadius="3"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Bond Gauge -->
                                <StackPanel Spacing="4">
                                    <DockPanel LastChildFill="True">
                                        <TextBlock Text="Bond Meter" FontSize="10" Foreground="#CBD5E1"/>
                                        <TextBlock Name="TxtCharBBond" DockPanel.Dock="Right" Text="0" FontSize="10" FontWeight="Bold" Foreground="#F43F5E"/>
                                    </DockPanel>
                                    <ProgressBar Name="ProgressCharBBond" Height="8" Minimum="-50" Maximum="50" Value="0" Foreground="#F43F5E" Background="#1E293B" CornerRadius="4"/>
                                </StackPanel>

                                <!-- Somatic Zones -->
                                <TextBlock Text="Somatic Zones:" FontSize="10" Foreground="#94A3B8" FontWeight="SemiBold"/>
                                <Border Background="#1E293B" CornerRadius="6" Padding="8">
                                    <TextBlock Name="TxtCharBSomatic" Text="Calm / None" FontSize="10" Foreground="#E2E8F0" TextWrapping="Wrap"/>
                                </Border>

                                <!-- Active Goals -->
                                <TextBlock Text="Active Goals:" FontSize="10" Foreground="#94A3B8" FontWeight="SemiBold"/>
                                <ItemsControl Name="ItemsCharBGoals">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="local:GoalViewModel">
                                            <Border Background="#1E293B" CornerRadius="4" Padding="6" Margin="0,0,0,4">
                                                <TextBlock Text="{Binding Title}" FontSize="10" FontWeight="Bold" Foreground="#F59E0B"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Border>

        </Grid>
    </DockPanel>
</Window>
