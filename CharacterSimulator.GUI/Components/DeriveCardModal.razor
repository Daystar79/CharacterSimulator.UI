@using CharacterSimulator.Logic
@using CharacterSimulator.Logic.Services
@inject TurnControlContext ControlContext

<div class="modal-overlay">
    <div class="modal-card" style="width: 640px; max-height: 90vh; overflow-y: auto;">
        <div class="modal-header">
            <div class="modal-title">📜 DERIVE CARD — Canon Character</div>
            <button class="btn btn-secondary" style="padding: 0.2rem 0.5rem;" @onclick="Close" disabled="@_isWorking">✕</button>
        </div>
        <div class="modal-body">
            <p style="font-size: 0.75rem; color: var(--text-secondary); line-height: 1.45;">
                Build an accuracy-locked identity card from <b>documented public canon</b> (wiki / official profile).
                Physical, history, and knowledge stay source-locked — blanks stay blank. File is saved under a random id; the selector shows the character name.
            </p>

            @if (_phase == Phase.Form)
            {
                <div class="form-group">
                    <label class="form-label">Character Name *</label>
                    <input class="form-control" @bind="_characterName" placeholder="e.g. Shinano, Deedlit, …" disabled="@_isWorking" />
                </div>

                <div class="form-group">
                    <label class="form-label">Filter / Variant (optional)</label>
                    <input class="form-control" @bind="_userFilter" placeholder="e.g. Azur Lane shipgirl · accurate · book version" disabled="@_isWorking" />
                </div>

                <div class="form-group">
                    <label class="form-label">LLM Provider</label>
                    <CustomSelect @bind-Value="_llmProvider" Options="_llmProviderOptions" />
                </div>

                <div class="form-group">
                    <label class="form-label">Canon Source Paste (optional — skips Wikipedia when set)</label>
                    <textarea class="form-control" rows="5" @bind="_sourcePaste"
                              placeholder="Paste wiki / official profile text here if network fetch is thin or offline…"
                              disabled="@_isWorking"></textarea>
                </div>

                <div style="font-size: 0.68rem; color: var(--text-muted); line-height: 1.4;">
                    * Derived packs are for private session use. You handle ToS/copyright for your use.
                    Wikipedia is tried automatically when paste is empty.
                </div>
            }
            else if (_phase == Phase.Working)
            {
                <div style="background: #0f172a; border: 1px solid var(--accent-purple); border-radius: 6px; padding: 1.25rem; text-align: center;">
                    <div class="spinner" style="margin-bottom: 0.75rem;"></div>
                    <div style="font-size: 0.9rem; font-weight: 700; color: var(--accent-purple);">@_statusLine</div>
                    <div style="font-size: 0.72rem; color: var(--text-muted); margin-top: 0.35rem;">
                        Fetch canon → map under locks → write random-id JSON card
                    </div>
                </div>
            }
            else if (_phase == Phase.Result && _result != null)
            {
                @if (_result.Success)
                {
                    <div style="background: #0f172a; border: 1px solid var(--accent-green); border-radius: 6px; padding: 0.75rem; margin-bottom: 0.75rem;">
                        <div style="font-size: 0.85rem; font-weight: 700; color: var(--accent-green);">
                            Ready: @_result.CharacterName · derived · source-locked
                        </div>
                        <div style="font-size: 0.72rem; color: var(--text-secondary); margin-top: 0.3rem;">
                            File: <code>@_result.CardFileName</code>
                            @if (_result.UsedMockLlm)
                            {
                                <span style="color: var(--accent-amber);"> · mock LLM (scaffold only)</span>
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(_result.SourceLabel))
                        {
                            <div style="font-size: 0.72rem; color: var(--text-muted); margin-top: 0.2rem;">
                                Source: @_result.SourceLabel
                                @if (!string.IsNullOrEmpty(_result.SourceUrl))
                                {
                                    <span> · @_result.SourceUrl</span>
                                }
                            </div>
                        }
                    </div>

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; margin-bottom: 0.75rem;">
                        <div style="background: #0f172a; border: 1px solid var(--border-color); border-radius: 6px; padding: 0.5rem;">
                            <div style="font-size: 0.68rem; font-weight: 700; color: var(--accent-blue); margin-bottom: 0.25rem;">KEPT</div>
                            <ul style="font-size: 0.7rem; color: var(--text-secondary); margin: 0; padding-left: 1rem;">
                                @foreach (var item in _result.Accuracy.Kept.DefaultIfEmpty("(none listed)"))
                                {
                                    <li>@item</li>
                                }
                            </ul>
                        </div>
                        <div style="background: #0f172a; border: 1px solid var(--border-color); border-radius: 6px; padding: 0.5rem;">
                            <div style="font-size: 0.68rem; font-weight: 700; color: var(--accent-amber); margin-bottom: 0.25rem;">LEFT BLANK</div>
                            <ul style="font-size: 0.7rem; color: var(--text-secondary); margin: 0; padding-left: 1rem;">
                                @foreach (var item in _result.Accuracy.LeftBlank.DefaultIfEmpty("(none listed)"))
                                {
                                    <li>@item</li>
                                }
                            </ul>
                        </div>
                    </div>

                    @if (_result.Accuracy.Compressed.Count > 0)
                    {
                        <div style="font-size: 0.7rem; color: var(--text-muted); margin-bottom: 0.5rem;">
                            Compressed: @string.Join("; ", _result.Accuracy.Compressed)
                        </div>
                    }

                    <div class="form-group">
                        <label class="form-label">Card JSON preview</label>
                        <textarea class="form-control" rows="10" readonly style="font-family: var(--font-mono); font-size: 0.68rem;">@_result.CardJson</textarea>
                    </div>
                }
                else
                {
                    <div style="background: #0f172a; border: 1px solid var(--accent-rose); border-radius: 6px; padding: 0.75rem;">
                        <div style="font-size: 0.85rem; font-weight: 700; color: var(--accent-rose);">Derive failed</div>
                        <div style="font-size: 0.75rem; color: var(--text-secondary); margin-top: 0.35rem; white-space: pre-wrap;">@_result.Error</div>
                    </div>
                }
            }

            @if (!string.IsNullOrEmpty(_errorMessage) && _phase == Phase.Form)
            {
                <div style="color: var(--accent-rose); font-size: 0.75rem; font-weight: 600; margin-top: 0.5rem;">@_errorMessage</div>
            }
        </div>
        <div class="modal-footer">
            @if (_phase == Phase.Form)
            {
                <button class="btn btn-secondary" @onclick="Close" disabled="@_isWorking">Cancel</button>
                <button class="btn btn-primary" @onclick="RunDerive" disabled="@_isWorking">📜 Derive Card</button>
            }
            else if (_phase == Phase.Working)
            {
                <button class="btn btn-secondary" @onclick="CancelWork">Cancel</button>
            }
            else
            {
                <button class="btn btn-secondary" @onclick="ResetForm">← Derive Another</button>
                <button class="btn btn-secondary" @onclick="Close">Close</button>
                @if (_result?.Success == true)
                {
                    <button class="btn btn-success" @onclick="AcceptAndRefresh">Load into Catalog ➔</button>
                }
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public EventCallback<DeriveCardService.DeriveCardResult?> OnClosed { get; set; }

    private enum Phase { Form, Working, Result }

    private Phase _phase = Phase.Form;
    private string _characterName = "";
    private string _userFilter = "";
    private string _sourcePaste = "";
    private string _llmProvider = "MockEngine";
    private bool _isWorking;
    private string _statusLine = "Starting…";
    private string _errorMessage = "";
    private DeriveCardService.DeriveCardResult? _result;
    private CancellationTokenSource? _cts;

    private List<CustomSelect.DropdownOption> _llmProviderOptions = new()
    {
        new("MockEngine", "🧪 Mock LLM (Offline scaffold)"),
        new("AGY", "🚀 Antigravity AGY / Gemini CLI"),
        new("MistralVibe", "⚡ Mistral Vibe"),
        new("Grok", "🧠 xAI Grok CLI"),
        new("Ollama", "🦙 Ollama CLI")
    };

    protected override void OnInitialized()
    {
        var settings = ControlContext.CurrentSettings ?? AppConfigService.LoadSettings();
        if (!string.IsNullOrWhiteSpace(settings.RoleplayLlmProvider))
            _llmProvider = settings.RoleplayLlmProvider;
    }

    private async Task RunDerive()
    {
        _errorMessage = "";
        if (string.IsNullOrWhiteSpace(_characterName))
        {
            _errorMessage = "Character name is required.";
            return;
        }

        _cts?.Cancel();
        _cts = new CancellationTokenSource();
        _isWorking = true;
        _phase = Phase.Working;
        _statusLine = "Resolving canon source…";
        StateHasChanged();

        try
        {
            // Brief UI tick so spinner paints
            await Task.Yield();
            _statusLine = string.IsNullOrWhiteSpace(_sourcePaste)
                ? "Fetching Wikipedia / mapping with LLM…"
                : "Using pasted source · mapping with LLM…";
            StateHasChanged();

            var request = new DeriveCardService.DeriveCardRequest
            {
                CharacterName = _characterName.Trim(),
                UserFilter = string.IsNullOrWhiteSpace(_userFilter) ? null : _userFilter.Trim(),
                SourcePaste = string.IsNullOrWhiteSpace(_sourcePaste) ? null : _sourcePaste.Trim(),
                LlmProvider = _llmProvider,
                SaveToDisk = true
            };

            _result = await DeriveCardService.DeriveAsync(request, _cts.Token);
            _phase = Phase.Result;
        }
        catch (OperationCanceledException)
        {
            _phase = Phase.Form;
            _errorMessage = "Derive cancelled.";
        }
        catch (Exception ex)
        {
            _phase = Phase.Result;
            _result = new DeriveCardService.DeriveCardResult
            {
                Success = false,
                CharacterName = _characterName,
                Error = ex.Message
            };
        }
        finally
        {
            _isWorking = false;
            StateHasChanged();
        }
    }

    private void CancelWork()
    {
        _cts?.Cancel();
        _isWorking = false;
        _phase = Phase.Form;
        _errorMessage = "Derive cancelled.";
    }

    private void ResetForm()
    {
        _phase = Phase.Form;
        _result = null;
        _errorMessage = "";
    }

    private async Task AcceptAndRefresh()
    {
        ControlContext.RefreshUI();
        await OnClosed.InvokeAsync(_result);
    }

    private async Task Close()
    {
        _cts?.Cancel();
        await OnClosed.InvokeAsync(_result?.Success == true ? _result : null);
    }
}
