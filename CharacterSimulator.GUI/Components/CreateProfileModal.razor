@inject ProfileService ProfileSvc

<div class="modal-overlay">
    <div class="modal-card">
        <div class="modal-header">
            <div class="modal-title">👤 CREATE NEW USER PROFILE</div>
            <button class="btn btn-secondary" style="padding: 0.2rem 0.5rem;" @onclick="Cancel">✕</button>
        </div>
        <div class="modal-body">
            @if (_createdProfile != null)
            {
                <div style="background: #0f172a; border: 1px solid var(--accent-green); border-radius: 6px; padding: 1rem; text-align: center;">
                    <div style="font-size: 0.85rem; font-weight: 700; color: var(--accent-green);">✅ Profile Created Successfully!</div>
                    <p style="font-size: 0.72rem; color: var(--text-secondary); margin-top: 0.5rem;">Below is your emergency <b>Recovery Code</b>. Keep this code safe in case you forget your PIN:</p>
                    <div style="background: #1e293b; color: var(--accent-amber); padding: 0.6rem; border-radius: 4px; font-family: monospace; font-size: 0.9rem; font-weight: 700; letter-spacing: 1px; margin: 0.5rem 0;">
                        @_createdProfile.RecoveryCode
                    </div>
                    <div style="font-size: 0.68rem; color: var(--text-muted);">* You can use this code to reset your security PIN at any time.</div>
                </div>
            }
            else
            {
                <p style="font-size: 0.75rem; color: var(--text-secondary);">Set up your player profile, date of birth (for adult path calculation), and optional PIN.</p>

                <div class="form-group">
                    <label class="form-label">Player / Profile Name:</label>
                    <input class="form-control" @bind="_name" placeholder="e.g. Player 1" />
                </div>

                <div class="form-group">
                    <label class="form-label">Date of Birth (Calendar Selector):</label>
                    <input type="date" class="form-control" @bind="_dob" min="1920-01-01" max="2026-12-31" />
                    <div style="font-size: 0.68rem; color: var(--text-muted);">* Age is calculated locally. Profiles under 18 have adult content paths locked.</div>
                </div>

                <div class="form-group">
                    <label class="form-label">Optional Security PIN (Leave blank for none):</label>
                    <input type="password" class="form-control" placeholder="Optional PIN..." @bind="_pin" />
                </div>

                <div style="display: flex; align-items: center; gap: 0.5rem; margin-top: 0.4rem;">
                    <input type="checkbox" id="adultAttest" @bind="_adultAttest" />
                    <label for="adultAttest" style="font-size: 0.75rem; color: var(--accent-amber); cursor: pointer;">I attest that I am 18+ and wish to enable Adult Mode</label>
                </div>

                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div style="color: var(--accent-rose); font-size: 0.75rem; font-weight: 600;">@_errorMessage</div>
                }
            }
        </div>
        <div class="modal-footer">
            @if (_createdProfile != null)
            {
                <button class="btn btn-success" @onclick="Finish">Done & Continue ➔</button>
            }
            else
            {
                <button class="btn btn-secondary" @onclick="Cancel">Cancel</button>
                <button class="btn btn-success" @onclick="SaveProfile">Save Profile</button>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public EventCallback<bool> OnClosed { get; set; }

    private string _name = "Player 1";
    private DateTime _dob = new DateTime(2000, 1, 1);
    private string _pin = "";
    private bool _adultAttest = false;
    private string _errorMessage = "";
    private UserProfile? _createdProfile = null;

    private void SaveProfile()
    {
        if (string.IsNullOrWhiteSpace(_name))
        {
            _errorMessage = "Please enter a valid display name.";
            return;
        }

        try
        {
            _createdProfile = ProfileSvc.CreateProfile(_name.Trim(), _dob.Year, _dob.Month, _dob.Day, string.IsNullOrWhiteSpace(_pin) ? null : _pin.Trim(), _adultAttest);
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private void Finish()
    {
        OnClosed.InvokeAsync(true);
    }

    private void Cancel()
    {
        OnClosed.InvokeAsync(false);
    }
}
