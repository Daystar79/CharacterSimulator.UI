@inject TurnControlContext ControlContext

<div class="modal-overlay">
    <div class="modal-card" style="width: 580px;">
        <div class="modal-header">
            <div class="modal-title">⚙️ SIMULATION SETUP WIZARD</div>
            <button class="btn btn-secondary" style="padding: 0.2rem 0.5rem;" @onclick="Close">✕</button>
        </div>
        <div class="modal-body">
            <p style="font-size: 0.75rem; color: var(--text-secondary);">Configure the character pair, scene context, genre, and interaction mode.</p>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
                <div class="form-group">
                    <label class="form-label">Character A (First Speaker):</label>
                    <CustomSelect @bind-Value="_selectedCharA" Options="_characterOptions" />
                </div>
                <div class="form-group">
                    <label class="form-label">Character B (Second Speaker):</label>
                    <CustomSelect @bind-Value="_selectedCharB" Options="_characterOptions" />
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">Simulation Genre:</label>
                <CustomSelect @bind-Value="_selectedGenre" Options="_genreOptions" />
            </div>

            <div class="form-group">
                <label class="form-label">Initial Scene Context / Location:</label>
                <textarea class="form-control" rows="3" @bind="_sceneContext" placeholder="Describe the scene setting..."></textarea>
            </div>

            <div class="form-group">
                <label class="form-label">Execution Mode:</label>
                <CustomSelect @bind-Value="_mode" Options="_modeOptions" />
            </div>

            <!-- AI LLM ENGINE CONFIGURATION SEGMENT -->
            <div style="background: #0f172a; border: 1px solid var(--accent-purple); border-radius: 6px; padding: 0.75rem; margin-top: 0.75rem;">
                <div style="font-size: 0.75rem; font-weight: 700; color: var(--accent-purple); display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                    <div style="display: flex; align-items: center; gap: 0.4rem;">
                        <span>🤖</span>
                        <span>AI LLM PROVIDER & ENGINE CONFIGURATION</span>
                    </div>
                    <button class="btn btn-secondary" style="padding: 0.15rem 0.4rem; font-size: 0.65rem;" @onclick="DetectEngines">🔍 Auto-Detect Engines</button>
                </div>

                <!-- SECTION 1: CHAT & SYSTEM ENGINE -->
                <div style="border-bottom: 1px solid rgba(255,255,255,0.08); padding-bottom: 0.5rem; margin-bottom: 0.5rem;">
                    <div style="font-size: 0.7rem; font-weight: 700; color: var(--accent-blue); margin-bottom: 0.3rem;">💬 1. CHAT & SYSTEM ENGINE (Player Prompts & Orchestration)</div>
                    <div style="display: grid; grid-template-columns: 1.2fr 1fr; gap: 0.5rem;">
                        <div class="form-group" style="margin-bottom: 0;">
                            <label class="form-label" style="font-size: 0.68rem;">Chat Provider Engine:</label>
                            <CustomSelect @bind-Value="_selectedChatLlmProvider" Options="_llmProviderOptions" />
                        </div>
                        <div class="form-group" style="margin-bottom: 0;">
                            <label class="form-label" style="font-size: 0.68rem;">Chat Model Tag:</label>
                            <input class="form-control" @bind="_chatModelIdentifier" placeholder="e.g. agy-pro, grok-2" />
                        </div>
                    </div>
                </div>

                <!-- SECTION 2: ROLEPLAY SIMULATION ENGINE -->
                <div>
                    <div style="font-size: 0.7rem; font-weight: 700; color: var(--accent-purple); margin-bottom: 0.3rem;">🎭 2. ROLEPLAY SIMULATION ENGINE (In-Character & Somatic Actions)</div>
                    <div style="display: grid; grid-template-columns: 1.2fr 1fr; gap: 0.5rem;">
                        <div class="form-group" style="margin-bottom: 0;">
                            <label class="form-label" style="font-size: 0.68rem;">Roleplay Provider Engine:</label>
                            <CustomSelect @bind-Value="_selectedRoleplayLlmProvider" Options="_llmProviderOptions" />
                        </div>
                        <div class="form-group" style="margin-bottom: 0;">
                            <label class="form-label" style="font-size: 0.68rem;">Roleplay Model Tag:</label>
                            <input class="form-control" @bind="_roleplayModelIdentifier" placeholder="e.g. mistral-small, llama3.2" />
                        </div>
                    </div>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; margin-top: 0.5rem;">
                    <div class="form-group" style="margin-bottom: 0;">
                        <label class="form-label">Temperature: @_temperature.ToString("F1")</label>
                        <input type="range" class="form-control" min="0.1" max="1.5" step="0.1" @bind="_temperature" style="padding: 0.2rem;" />
                    </div>
                    <div class="form-group" style="margin-bottom: 0;">
                        <label class="form-label">Max Response Tokens:</label>
                        <input type="number" class="form-control" min="128" max="4096" step="128" @bind="_maxTokens" />
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(_detectionStatus))
                {
                    <div style="font-size: 0.68rem; color: var(--accent-green); font-weight: 600; margin-top: 0.4rem;">@_detectionStatus</div>
                }
            </div>

            @if (!string.IsNullOrEmpty(_warningMessage))
            {
                <div style="color: var(--accent-amber); font-size: 0.72rem; font-weight: 600; margin-top: 0.4rem;">@_warningMessage</div>
            }
        </div>
        <div class="modal-footer">
            <button class="btn btn-secondary" @onclick="Close">Cancel</button>
            <button class="btn btn-success" @onclick="StartSimulation">🚀 Launch Simulation</button>
        </div>
    </div>
</div>

@code {
    [Parameter] public EventCallback<bool> OnClosed { get; set; }

    private List<CustomSelect.DropdownOption> _characterOptions = new()
    {
        new("", "(None / Not Selected)")
    };

    private List<CustomSelect.DropdownOption> _genreOptions = new()
    {
        new("Contemporary", "Contemporary"),
        new("Cyberpunk", "Cyberpunk"),
        new("Sci-Fi", "Sci-Fi"),
        new("Fantasy", "Fantasy"),
        new("Noir", "Noir")
    };

    private List<CustomSelect.DropdownOption> _modeOptions = new()
    {
        new("AutoPlay", "🤖 Auto-Play Mode (Autonomous AI Roleplay)"),
        new("PlayerGuided", "🎮 Player-Guided Mode (Human Prompt Injected)")
    };

    private List<CustomSelect.DropdownOption> _llmProviderOptions = new()
    {
        new("AGY", "🚀 Antigravity AGY (Engine / CLI)"),
        new("Grok", "🧠 xAI Grok (API / CLI)"),
        new("MistralVibe", "⚡ Mistral Vibe (Local CLI)"),
        new("Ollama", "🦙 Ollama API (http://localhost:11434)"),
        new("MockEngine", "🧪 Mock LLM Engine (Offline Test)")
    };

    private string _selectedCharA = "";
    private string _selectedCharB = "";
    private string _selectedGenre = "Contemporary";
    private string _sceneContext = "Quiet city apartment at midnight during a rainstorm.";
    private string _mode = "PlayerGuided";
    private string _selectedChatLlmProvider = "AGY";
    private string _chatModelIdentifier = "agy-pro";
    private string _selectedRoleplayLlmProvider = "MistralVibe";
    private string _roleplayModelIdentifier = "mistral-small";
    private double _temperature = 0.7;
    private int _maxTokens = 1024;
    private string _detectionStatus = "";
    private string _warningMessage = "";

    protected override async Task OnInitializedAsync()
    {
        var catalog = CharacterCatalog.ListCardFileNames();
        _characterOptions = new List<CustomSelect.DropdownOption> { new("", "(None / Not Selected)") };
        foreach (var c in catalog)
        {
            _characterOptions.Add(new(c, c));
        }

        await DetectEngines();
    }

    private async Task DetectEngines()
    {
        _detectionStatus = "🔍 Scanning local environment for AGY, Grok, Mistral & Ollama engines...";
        StateHasChanged();

        var engines = await LlmEngineDetector.DetectAvailableEnginesAsync();
        _llmProviderOptions.Clear();

        foreach (var eng in engines)
        {
            string status = eng.IsAvailable ? "✅ Available" : "❌ Not Found";
            _llmProviderOptions.Add(new(eng.Id, $"{eng.DisplayName} ({status})"));
        }

        var availableChat = engines.Find(e => e.IsAvailable && e.Id != "MockEngine");
        if (availableChat != null)
        {
            _selectedChatLlmProvider = availableChat.Id;
            _selectedRoleplayLlmProvider = availableChat.Id;
            _detectionStatus = $"✅ Auto-detected active engine: {availableChat.DisplayName}";
        }
        else
        {
            _selectedChatLlmProvider = "MockEngine";
            _selectedRoleplayLlmProvider = "MockEngine";
            _detectionStatus = "ℹ️ Offline mode: Mock LLM Engine active.";
        }

        StateHasChanged();
    }

    private void StartSimulation()
    {
        if (string.IsNullOrEmpty(_selectedCharA) && string.IsNullOrEmpty(_selectedCharB))
        {
            _warningMessage = "⚠️ Please select at least one character to launch the simulation stage.";
            return;
        }

        OnClosed.InvokeAsync(true);
    }

    private void Close()
    {
        OnClosed.InvokeAsync(false);
    }
}
