@inject TurnControlContext ControlContext

<div class="modal-overlay">
    <div class="modal-card" style="width: 580px;">
        <div class="modal-header">
            <div class="modal-title">⚙️ SIMULATION SETUP WIZARD</div>
            <button class="btn btn-secondary" style="padding: 0.2rem 0.5rem;" @onclick="Close">✕</button>
        </div>
        <div class="modal-body">
            <p style="font-size: 0.75rem; color: var(--text-secondary);">Configure the character pair, scene context, genre, and interaction mode.</p>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
                <div class="form-group">
                    <label class="form-label">Character A (First Speaker):</label>
                    <select class="form-control" @bind="_selectedCharA">
                        @foreach (var c in _availableCharacters)
                        {
                            <option value="@c">@c</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Character B (Second Speaker):</label>
                    <select class="form-control" @bind="_selectedCharB">
                        @foreach (var c in _availableCharacters)
                        {
                            <option value="@c">@c</option>
                        }
                    </select>
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">Simulation Genre:</label>
                <select class="form-control" @bind="_selectedGenre">
                    <option value="Contemporary">Contemporary</option>
                    <option value="Cyberpunk">Cyberpunk</option>
                    <option value="Sci-Fi">Sci-Fi</option>
                    <option value="Fantasy">Fantasy</option>
                    <option value="Noir">Noir</option>
                </select>
            </div>

            <div class="form-group">
                <label class="form-label">Initial Scene Context / Location:</label>
                <textarea class="form-control" rows="3" @bind="_sceneContext" placeholder="Describe the scene setting..."></textarea>
            </div>

            <div class="form-group">
                <label class="form-label">Execution Mode:</label>
                <select class="form-control" @bind="_mode">
                    <option value="AutoPlay">🤖 Auto-Play Mode (Autonomous AI Roleplay)</option>
                    <option value="PlayerGuided">🎮 Player-Guided Mode (Human Prompt Injected)</option>
                </select>
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn btn-secondary" @onclick="Close">Cancel</button>
            <button class="btn btn-success" @onclick="StartSimulation">🚀 Launch Simulation</button>
        </div>
    </div>
</div>

@code {
    [Parameter] public EventCallback<bool> OnClosed { get; set; }

    private List<string> _availableCharacters = new() { "serena.md", "kira.md", "victor.md" };
    private string _selectedCharA = "serena.md";
    private string _selectedCharB = "kira.md";
    private string _selectedGenre = "Contemporary";
    private string _sceneContext = "Quiet city apartment at midnight during a rainstorm.";
    private string _mode = "AutoPlay";

    protected override void OnInitialized()
    {
        var catalog = CharacterCatalog.ListCardFileNames();
        if (catalog.Count > 0)
        {
            _availableCharacters = catalog;
            _selectedCharA = _availableCharacters[0];
            _selectedCharB = _availableCharacters.Count > 1 ? _availableCharacters[1] : _availableCharacters[0];
        }
    }

    private void StartSimulation()
    {
        OnClosed.InvokeAsync(true);
    }

    private void Close()
    {
        OnClosed.InvokeAsync(false);
    }
}
