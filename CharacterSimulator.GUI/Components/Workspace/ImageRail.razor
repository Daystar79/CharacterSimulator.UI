@* Left rail: one stage still — character physical + scene combined *@

<div class="character-panel character-panel-left image-rail">
    <div class="image-block image-block-full">
        <div class="image-block-label">Stage</div>
        <div class="scene-stage stage-frame">
            @if (!string.IsNullOrEmpty(StageImagePath) && (File.Exists(StageImagePath) || StageImagePath.StartsWith("http") || StageImagePath.StartsWith("data:")))
            {
                <img class="scene-stage-img" src="@StageImagePath" alt="Stage" />
            }
            else
            {
                <div class="scene-stage-fallback">
                    <div class="canvas-avatar-icon">@(IsCharacterLoaded ? "🎭" : "🏙️")</div>
                    <div class="canvas-char-name">
                        @(IsCharacterLoaded ? CharName : GenreDisplayName)
                    </div>
                    <div class="canvas-bio">
                        @if (IsCharacterLoaded && !string.IsNullOrWhiteSpace(SceneLocationText))
                        {
                            @((SceneLocationText.Length > 120 ? SceneLocationText[..117] + "…" : SceneLocationText))
                        }
                        else if (!string.IsNullOrWhiteSpace(SceneLocationText))
                        {
                            @("Environment only — select a character for a full stage still.")
                        }
                        else
                        {
                            @("Set genre/location (and character) on the right, then generate.")
                        }
                    </div>
                </div>
            }
        </div>
        <div class="image-rail-actions">
            <button class="btn btn-secondary scene-generate-btn" disabled="@IsGenerating" @onclick="HandleGenerate">
                @(IsGenerating ? "✨ Rendering image..." : "🎨 Generate Image")
            </button>
            <button class="btn btn-secondary scene-settings-btn" @onclick="HandleOpenImagingSettings" title="Imaging Settings">
                ⚙️ Settings
            </button>
        </div>
        <div class="image-rail-hint">
            Combines scene location with character physical &amp; style into one still.
        </div>
    </div>
</div>

@code {
    [Parameter] public string StageImagePath { get; set; } = "";
    [Parameter] public string GenreDisplayName { get; set; } = "";
    [Parameter] public string SceneLocationText { get; set; } = "";
    [Parameter] public bool IsGenerating { get; set; }
    [Parameter] public bool IsCharacterLoaded { get; set; }
    [Parameter] public string CharName { get; set; } = "";
    [Parameter] public EventCallback OnGenerate { get; set; }
    [Parameter] public EventCallback OnOpenImagingSettings { get; set; }

    private Task HandleGenerate() => OnGenerate.InvokeAsync();
    private Task HandleOpenImagingSettings() => OnOpenImagingSettings.InvokeAsync();
}
