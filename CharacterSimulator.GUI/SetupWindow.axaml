<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="560"
        x:Class="CharacterSimulator.GUI.SetupWindow"
        Title="Simulation Setup &amp; LLM Configuration"
        Width="560" Height="560"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="#0F172A">

    <DockPanel LastChildFill="True">
        
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="#1E293B" Padding="16,12" BorderBrush="#334155" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border CornerRadius="6" Background="#2563EB" Width="28" Height="28">
                    <TextBlock Text="⚙️" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="SIMULATION SETUP &amp; LLM CONFIGURATION" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC"/>
                    <TextBlock Text="Character cards from CharacterSimulator · genre is scene tone only" FontSize="10" Foreground="#94A3B8"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Bottom Action Buttons -->
        <Border DockPanel.Dock="Bottom" Background="#1E293B" Padding="16,10" BorderBrush="#334155" BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="True">
                <Button Name="BtnCancel" DockPanel.Dock="Left" Content="✖ Cancel" Background="#334155" Foreground="#CBD5E1" Padding="14,8" CornerRadius="6" Click="OnCancelClicked"/>
                <Button Name="BtnApply" DockPanel.Dock="Right" Content="💾 Apply Settings" Background="#16A34A" Foreground="White" FontWeight="Bold" Padding="16,8" CornerRadius="6" Click="OnApplyClicked"/>
            </DockPanel>
        </Border>

        <!-- Form Body -->
        <ScrollViewer Padding="20">
            <StackPanel Spacing="14">
                
                <!-- Character Selection Row -->
                <Grid ColumnDefinitions="*,*">
                    <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,6,0">
                        <TextBlock Text="Character 1 (Player A):" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                        <ComboBox Name="ComboCharA" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4" Margin="6,0,0,0">
                        <TextBlock Text="Character 2 (Player B):" FontSize="11" FontWeight="Bold" Foreground="#F43F5E"/>
                        <ComboBox Name="ComboCharB" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Grid>

                <!-- LLM Provider Selection Row -->
                <Grid ColumnDefinitions="*,*">
                    <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,6,0">
                        <TextBlock Text="LLM Provider A:" FontSize="11" FontWeight="Bold" Foreground="#CBD5E1"/>
                        <ComboBox Name="ComboLlmA" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4" Margin="6,0,0,0">
                        <TextBlock Text="LLM Provider B:" FontSize="11" FontWeight="Bold" Foreground="#CBD5E1"/>
                        <ComboBox Name="ComboLlmB" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Grid>

                <!-- Genre (environment tone only) -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Scene Genre (environment tone — does not rewrite characters):" FontSize="11" FontWeight="Bold" Foreground="#A78BFA"/>
                    <ComboBox Name="ComboGenre" HorizontalAlignment="Stretch" SelectionChanged="OnGenreSelectionChanged"/>
                    <TextBlock Name="TxtGenreHint" Text="" FontSize="10" Foreground="#94A3B8" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Scene preset + freeform -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Scene Preset:" FontSize="11" FontWeight="Bold" Foreground="#F59E0B"/>
                    <ComboBox Name="ComboScenePreset" HorizontalAlignment="Stretch" SelectionChanged="OnScenePresetChanged"/>
                    <TextBlock Text="Scene Location &amp; Detail (editable):" FontSize="11" FontWeight="Bold" Foreground="#F59E0B" Margin="0,6,0,0"/>
                    <TextBox Name="TxtScene" AcceptsReturn="True" Height="70" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Max Turns -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Max Simulation Turns:" FontSize="11" FontWeight="Bold" Foreground="#CBD5E1"/>
                    <NumericUpDown Name="NumTurns" Minimum="1" Maximum="100" Value="10" Width="120" HorizontalAlignment="Left"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
