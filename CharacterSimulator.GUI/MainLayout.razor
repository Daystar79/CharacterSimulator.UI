@inherits LayoutComponentBase
@inject TurnControlContext ControlContext
@inject SimulationHost SimHost
@inject IJSRuntime JS
@* ProfileService resolved lazily after first paint — inject was forcing SQLite open during splash *@

<div class="app-container">
    
    <!-- 1. TOP MENU BAR -->
    <div class="top-menu-bar">
        <div class="menu-item">
            <span>⚙️ Settings</span>
            <div class="menu-dropdown">
                <div class="dropdown-action" @onclick='() => OpenSetupModal("Roleplaying")'>🎭 Roleplaying Configuration...</div>
                <div class="dropdown-action" @onclick='() => OpenSetupModal("Imaging")'>🎨 Imaging Configuration...</div>
                <div class="dropdown-divider"></div>
                <div class="dropdown-action" @onclick="OpenDeriveCardModal">📜 Derive Card (Canon)...</div>
                <div class="dropdown-divider"></div>
                <div class="dropdown-action" @onclick="TriggerRefreshUI">🔄 Complete UI Refresh</div>
                <div class="dropdown-divider"></div>
                <div class="dropdown-action" @onclick="OpenSavedSessionsModal">📂 Saved Sessions & Exports...</div>
                <div class="dropdown-divider"></div>
                <div class="dropdown-action" @onclick="ResetStage">↺ Reset Stage</div>
            </div>
        </div>
        <div class="menu-item">
            <span>👤 Profile</span>
            <div class="menu-dropdown">
                <div class="dropdown-action" @onclick="OpenProfilePickerModal">🔑 Switch Profile...</div>
                <div class="dropdown-action" @onclick="OpenChangePinModal">🔒 Security PIN & Recovery...</div>
            </div>
        </div>
        <div class="menu-item">
            <span>🎮 Mode</span>
            <div class="menu-dropdown">
                <div class="dropdown-action" @onclick="SetAutoPlayMode">🤖 Auto-Play Mode</div>
                <div class="dropdown-action" @onclick="SetPlayerGuidedMode">🎮 Player-Guided Mode</div>
            </div>
        </div>
        <div class="menu-item">
            <span>⏯ Playback</span>
            <div class="menu-dropdown">
                <div class="dropdown-action" @onclick="PlaySimulation">▶ Play</div>
                <div class="dropdown-action" @onclick="PauseSimulation">⏸ Pause</div>
                <div class="dropdown-action" @onclick="StepSimulation">⏭ Step</div>
                <div class="dropdown-divider"></div>
                <div class="dropdown-action" @onclick="StopSimulation">⏹ Stop</div>
            </div>
        </div>
    </div>

    <!-- 2. PLAYBACK TOOLBAR -->
    <div class="playback-toolbar">
        <div class="toolbar-left">
            <div class="app-badge-title">
                <div class="icon-box">🎭</div>
                <span>CHARACTER SIMULATOR</span>
            </div>
            <span class="badge @StatusBadgeClass">● @_statusBadgeText</span>
            <span class="badge badge-profile">👤 @_activeProfileBadge</span>
            <span class="badge badge-ready">@_activeModeBadge</span>
        </div>

        <div class="toolbar-right">
            <button class="btn btn-secondary" style="border: 1px solid var(--accent-blue); color: var(--accent-blue);" @onclick="TriggerRefreshUI">🔄 Refresh UI</button>
            <button class="btn btn-success" disabled="@_isPlaying" @onclick="PlaySimulation">▶ Play</button>

            <div class="menu-item" style="padding: 0;">
                <button class="btn btn-secondary">⚙️ Controls ▾</button>
                <div class="menu-dropdown" style="right: 0; left: auto;">
                    <div class="dropdown-action" @onclick="PauseSimulation">⏸ Pause Simulation</div>
                    <div class="dropdown-action" @onclick="StepSimulation">⏭ Step (Single Turn)</div>
                    <div class="dropdown-divider"></div>
                    <div class="dropdown-action" @onclick="StopSimulation">⏹ Stop Simulation</div>
                </div>
            </div>

            <div style="height: 18px; width: 1px; background: var(--border-color); margin: 0 0.25rem;"></div>

            <div style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.75rem;">
                <span style="color: var(--text-secondary);">⚡ Delay:</span>
                <span style="color: var(--accent-amber); font-weight: 700;">@(_delayMs)ms</span>
                <input type="range" min="100" max="3000" step="50" value="@_delayMs" @oninput="OnDelayChanged" style="width: 80px;" />
            </div>
        </div>
    </div>

    <!-- 3. MAIN WORKSPACE CONTENT BODY -->
    @Body

    <!-- 4. BOTTOM STATUS BAR -->
    <div class="bottom-status-bar">
        <span>@_statusText</span>
        <div style="display: flex; align-items: center; gap: 0.75rem;">
            @if (_isWaitingForLlm)
            {
                <div class="waiting-badge">
                    <span>⏳</span>
                    <span>Waiting for LLM response...</span>
                </div>
            }
            <span style="background: #0f172a; border: 1px solid var(--accent-green); color: var(--accent-green); padding: 0.15rem 0.5rem; border-radius: 4px; font-weight: 700;">
                ⚡ @_activeLlmInfo
            </span>
            <span>.NET 10.0 • Blazor Desktop</span>
        </div>
    </div>

</div>

<!-- MODAL DIALOGS -->
@if (_showProfilePickerModal)
{
    <ProfilePickerModal OnClosed="OnProfilePickerClosed" OnCreateRequested="OpenCreateProfileModal" />
}

@if (_showCreateProfileModal)
{
    <CreateProfileModal OnClosed="OnCreateProfileClosed" />
}

@if (_showSetupModal)
{
    <SimulationSetupModal ActiveSection="@_setupActiveSection" OnClosed="OnSetupModalClosed" />
}

@if (_showSavedSessionsModal)
{
    <SavedSessionsModal OnSessionSelected="OnSavedSessionSelected" />
}

@if (_showChangePinModal)
{
    <ChangePinModal OnClosed="OnChangePinClosed" />
}

@if (_showDeriveCardModal)
{
    <DeriveCardModal OnClosed="OnDeriveCardClosed" />
}

@implements IDisposable

@code {
    private string _statusBadgeText = "READY";
    private string StatusBadgeClass => _statusBadgeText switch
    {
        "RUNNING" => "badge-running",
        "PAUSED" => "badge-paused",
        "STOPPED" => "badge-stopped",
        _ => "badge-ready"
    };

    private string _activeProfileBadge = "Player 1 (Age 25)";
    private string _activeModeBadge = "🎮 Player-Guided";
    private string _statusText = "Ready. Click File ➔ Simulation Setup to configure characters.";
    private string _activeLlmInfo = "Agent A: Mock | Agent B: Mock";
    private int _delayMs = 600;
    private bool _isPlaying = false;
    private bool _isWaitingForLlm = false;

    private bool _showProfilePickerModal = false;
    private bool _showCreateProfileModal = false;
    private bool _showSetupModal = false;
    private bool _showSavedSessionsModal = false;
    private bool _showChangePinModal = false;
    private bool _showDeriveCardModal = false;

    private ProfileService? _profileSvc;
    private bool _profileHooked;

    protected override void OnInitialized()
    {
        try
        {
            ApplySettings(ControlContext.CurrentSettings);
        }
        catch (Exception ex)
        {
            _statusText = "Startup warning: " + ex.Message;
        }

        ControlContext.OnStateChanged += OnSimulationStateChanged;
        ControlContext.OnUIUpdated += OnUIAutoRefresh;
        ControlContext.OnSettingsChanged += OnSettingsUpdated;
        SimHost.OnWaitingChanged += OnHostWaitingChanged;
        SimHost.OnStatus += OnHostStatus;
        SimHost.OnModeChanged += OnHostModeChanged;
        SimHost.OnRequestSetup += OnHostRequestSetup;
        // Do not touch ProfileService here — that opened SQLite during first layout render
        // and any exception left the HTML splash stuck forever.
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender || _profileHooked) return;
        _profileHooked = true;
        try
        {
            _profileSvc = ProfileService.Instance;
            _profileSvc.OnActiveProfileChanged += OnProfileAutoRefresh;
            UpdateActiveProfileBadge();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            _statusText = "Profile DB delayed: " + ex.Message;
            StateHasChanged();
        }
    }

    private void TriggerRefreshUI()
    {
        ControlContext.RefreshUI();
        _statusText = "🔄 Complete UI refresh executed. Re-scanned character cards and configuration from disk.";
        StateHasChanged();
    }

    public void Dispose()
    {
        ControlContext.OnStateChanged -= OnSimulationStateChanged;
        ControlContext.OnUIUpdated -= OnUIAutoRefresh;
        ControlContext.OnSettingsChanged -= OnSettingsUpdated;
        SimHost.OnWaitingChanged -= OnHostWaitingChanged;
        SimHost.OnStatus -= OnHostStatus;
        SimHost.OnModeChanged -= OnHostModeChanged;
        SimHost.OnRequestSetup -= OnHostRequestSetup;
        if (_profileSvc != null)
            _profileSvc.OnActiveProfileChanged -= OnProfileAutoRefresh;
    }

    private void OnHostWaitingChanged(bool waiting)
    {
        InvokeAsync(() =>
        {
            _isWaitingForLlm = waiting;
            StateHasChanged();
        });
    }

    private void OnHostStatus(string text)
    {
        InvokeAsync(() =>
        {
            _statusText = text;
            StateHasChanged();
        });
    }

    private void OnHostModeChanged(string badge)
    {
        InvokeAsync(() =>
        {
            _activeModeBadge = badge;
            StateHasChanged();
        });
    }

    private void OnHostRequestSetup()
    {
        InvokeAsync(() =>
        {
            OpenSetupModal("Roleplaying");
            StateHasChanged();
        });
    }

    private void OnSettingsUpdated(AppSettings settings)
    {
        InvokeAsync(() => ApplySettings(settings));
    }

    private void ApplySettings(AppSettings settings)
    {
        if (settings == null) return;
        _activeModeBadge = settings.RoleplayMode == "AutoPlay" ? "🤖 Auto-Play" : "🎮 Player-Guided";
        _activeLlmInfo = $"Roleplay: {settings.RoleplayLlmProvider} ({settings.RoleplayModelIdentifier}) | Image: {settings.ImageEngine}";
        _statusText = $"Active Engine: {settings.RoleplayLlmProvider} ({settings.RoleplayModelIdentifier}) / {settings.ImageEngine}";
        StateHasChanged();
    }

    private void OnUIAutoRefresh()
    {
        InvokeAsync(StateHasChanged);
    }

    private void OnProfileAutoRefresh(UserProfile? profile)
    {
        InvokeAsync(() =>
        {
            UpdateActiveProfileBadge();
            StateHasChanged();
        });
    }

    private void UpdateActiveProfileBadge()
    {
        try
        {
            var profile = (_profileSvc ?? ProfileService.Instance).ActiveProfile;
            if (profile != null)
                _activeProfileBadge = $"{profile.DisplayName} (Age {profile.CalculateAge()})";
        }
        catch
        {
            _activeProfileBadge = "Profile (pending)";
        }
    }

    private void OnSimulationStateChanged(SimulationState state)
    {
        InvokeAsync(() =>
        {
            switch (state)
            {
                case SimulationState.Running:
                    _statusBadgeText = "RUNNING";
                    _isPlaying = true;
                    _statusText = "Simulation running...";
                    break;
                case SimulationState.Paused:
                    _statusBadgeText = "PAUSED";
                    _isPlaying = false;
                    _statusText = "Simulation paused.";
                    break;
                case SimulationState.Stopped:
                    _statusBadgeText = "STOPPED";
                    _isPlaying = false;
                    _statusText = "Simulation stopped.";
                    break;
            }
            StateHasChanged();
        });
    }

    private void OnDelayChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int val))
        {
            _delayMs = val;
            ControlContext.DelayMs = val;
        }
    }

    private void PlaySimulation()
    {
        SimHost.Play();
    }

    private void PauseSimulation()
    {
        SimHost.Pause();
    }

    private void StepSimulation()
    {
        SimHost.Step();
    }

    private void StopSimulation()
    {
        SimHost.Stop();
    }

    private void SetAutoPlayMode()
    {
        SimHost.SetRoleplayMode("AutoPlay");
        _activeModeBadge = "🤖 Auto-Play";
    }

    private void SetPlayerGuidedMode()
    {
        SimHost.SetRoleplayMode("PlayerGuided");
        _activeModeBadge = "🎮 Player-Guided";
    }

    private void OpenProfilePickerModal()
    {
        _showProfilePickerModal = true;
    }

    private void OnProfilePickerClosed(bool profileSwitched)
    {
        _showProfilePickerModal = false;
        if (profileSwitched)
        {
            UpdateActiveProfileBadge();
        }
    }

    private void OpenCreateProfileModal()
    {
        _showProfilePickerModal = false;
        _showCreateProfileModal = true;
    }

    private void OnCreateProfileClosed(bool profileCreated)
    {
        _showCreateProfileModal = false;
        if (profileCreated)
        {
            UpdateActiveProfileBadge();
        }
    }

    private void OpenSavedSessionsModal()
    {
        _showSavedSessionsModal = true;
    }

    private void OnSavedSessionSelected(DbSession? session)
    {
        _showSavedSessionsModal = false;
        if (session != null)
        {
            _statusText = $"Resumed session '{session.Title}'. Scene: [{session.Genre}] {session.Scene}";
            // Push session scene into settings so left-panel Location & Genre pick it up
            try
            {
                var s = ControlContext.CurrentSettings ?? new AppSettings();
                if (!string.IsNullOrWhiteSpace(session.Genre))
                    s.SelectedGenre = session.Genre;
                if (!string.IsNullOrWhiteSpace(session.Scene))
                    s.ScenePrompt = session.Scene;
                ControlContext.UpdateSettings(s);
            }
            catch { }
            ControlContext.NotifyUIUpdate();
        }
    }

    private void OpenChangePinModal()
    {
        _showChangePinModal = true;
    }

    private void OnChangePinClosed(bool updated)
    {
        _showChangePinModal = false;
    }

    private string _setupActiveSection = "Roleplaying";

    private void OpenSetupModal(string section = "Roleplaying")
    {
        _setupActiveSection = section;
        _showSetupModal = true;
    }

    private void OnSetupModalClosed(bool launched)
    {
        _showSetupModal = false;
        if (launched)
        {
            // Setup saved SelectedCharA/B + engines — stage primary card and offer to run.
            var s = ControlContext.CurrentSettings;
            if (!string.IsNullOrWhiteSpace(s?.SelectedCharA))
                SimHost.SetStagedCharacter(s.SelectedCharA);
            _statusText = "Setup saved. Press ▶ Play or send a line in Dialogue to start.";
            // Auto-start so Launch Simulation is one click.
            SimHost.Play();
        }
    }

    private void OpenDeriveCardModal()
    {
        _showDeriveCardModal = true;
    }

    private void OnDeriveCardClosed(DeriveCardService.DeriveCardResult? result)
    {
        _showDeriveCardModal = false;
        if (result?.Success == true)
        {
            _statusText = $"Derived card saved: {result.CharacterName} ({result.CardFileName}). Select it in a character slot.";
            ControlContext.RefreshUI();
        }
    }

    private void ResetStage()
    {
        SimHost.Reset();
        _statusText = "Stage reset. Load a character or open Settings → Roleplaying.";
    }
}
