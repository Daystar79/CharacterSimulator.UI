@page "/"
@inject TurnControlContext ControlContext
@inject IJSRuntime JS

<div class="workspace-grid">
    
    <!-- LEFT PANEL: 3 TABS (SCENE IMAGE / HISTORY / SYSTEM OUTPUT) -->
    <div class="character-panel">
        <!-- TAB HEADER -->
        <div class="panel-tabs-header">
            <button class="panel-tab-btn @(_leftPanelTab == "Scene" ? "active" : "")" @onclick='() => _leftPanelTab = "Scene"'>
                🖼️ SCENE IMAGE
            </button>
            <button class="panel-tab-btn @(_leftPanelTab == "History" ? "active" : "")" @onclick='() => _leftPanelTab = "History"'>
                📜 HISTORY
            </button>
            <button class="panel-tab-btn @(_leftPanelTab == "System" ? "active" : "")" @onclick='() => _leftPanelTab = "System"'>
                ⚙️ SYSTEM OUTPUT
            </button>
        </div>

        @if (_leftPanelTab == "Scene")
        {
            <!-- SCENE IMAGE VIEW -->
            <div class="portrait-container">
                @if (!string.IsNullOrEmpty(_sceneImagePath) && (System.IO.File.Exists(_sceneImagePath) || _sceneImagePath.StartsWith("http")))
                {
                    <img class="portrait-img" src="@_sceneImagePath" alt="Scene Location" style="aspect-ratio: 16/9; object-fit: cover;" />
                }
                else
                {
                    <div class="canvas-fallback" style="padding: 1.5rem 1rem;">
                        <div class="canvas-avatar-icon" style="font-size: 2rem;">🏙️</div>
                        <div class="canvas-char-name" style="font-size: 0.8rem;">Quiet City Apartment</div>
                        <div class="canvas-bio" style="font-size: 0.7rem;">Midnight during a rainstorm. Warm ambient lighting.</div>
                    </div>
                }
                <button class="btn btn-secondary" style="width: 100%; margin-top: 0.4rem; font-size: 0.7rem; padding: 0.25rem;" disabled="@_isGeneratingScene" @onclick="GenerateSceneArtwork">
                    @(_isGeneratingScene ? "✨ Rendering Scene..." : "✨ Generate Scene Artwork")
                </button>
            </div>

            <div style="margin-top: 0.75rem; background: #0f172a; border: 1px solid var(--border-color); border-radius: 6px; padding: 0.6rem;">
                <div class="section-title" style="margin-bottom: 0.3rem; font-size: 0.7rem; color: var(--accent-amber);">
                    <span>📍</span>
                    <span>LOCATION & ATMOSPHERE</span>
                </div>
                <div style="font-size: 0.72rem; color: var(--text-secondary); line-height: 1.4;">
                    Contemporary urban apartment setting. Soft neon reflections on wet glass window panes.
                </div>
            </div>
        }
        else if (_leftPanelTab == "History")
        {
            <!-- SESSION TURN HISTORY VIEW -->
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.4rem;">
                <span class="section-title" style="margin: 0; color: var(--accent-blue);">📜 SESSION HISTORY LOG</span>
                <span style="font-size: 0.68rem; color: var(--text-muted);">Turns: @_dialogueFeed.Count</span>
            </div>
            <div class="output-log-container">
                @for (int i = 0; i < _dialogueFeed.Count; i++)
                {
                    var turn = _dialogueFeed[i];
                    <div style="border-bottom: 1px solid rgba(255,255,255,0.06); padding-bottom: 0.35rem; margin-bottom: 0.35rem;">
                        <div style="font-weight: 700; color: @turn.SpeakerColor; font-size: 0.7rem;">
                            Turn #@(i + 1): @turn.SpeakerName @(turn.IsSystem ? "" : $"➔ {turn.TargetName}")
                        </div>
                        <div style="font-size: 0.68rem; color: var(--text-secondary); margin-top: 0.15rem;">
                            @turn.Dialogue
                        </div>
                        @if (!string.IsNullOrEmpty(turn.BondDeltaText))
                        {
                            <div style="font-size: 0.65rem; color: var(--accent-purple); margin-top: 0.1rem;">🔗 @turn.BondDeltaText</div>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <!-- SYSTEM OUTPUT LOG TERMINAL VIEW -->
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.4rem;">
                <span class="section-title" style="margin: 0; color: var(--accent-blue);">⚙️ SYSTEM DIAGNOSTICS & LOG</span>
                <button class="btn btn-secondary" style="padding: 0.15rem 0.4rem; font-size: 0.65rem;" @onclick="ClearLogs">Clear</button>
            </div>
            <div class="output-log-container" id="outputLogBox">
                @foreach (var entry in _outputLogs)
                {
                    <div class="log-entry @entry.LevelClass">
                        <span class="log-time">[@entry.Timestamp.ToString("HH:mm:ss")]</span>
                        <span>@entry.Message</span>
                    </div>
                }
            </div>
        }
    </div>

    <!-- CENTER PANEL: DIALOGUE FEED -->
    <div class="feed-panel">
        <div class="feed-messages" id="dialogueFeed">
            @foreach (var msg in _dialogueFeed)
            {
                <div class="chat-bubble @(msg.IsSystem ? "chat-system" : (msg.IsLeft ? "chat-left" : "chat-right"))">
                    @if (!msg.IsSystem)
                    {
                        <div class="chat-header">
                            <span class="speaker-name" style="color: @msg.SpeakerColor;">@msg.SpeakerName ➔ @msg.TargetName</span>
                            <span>@msg.SpeakerEmotionEmoji</span>
                        </div>
                        @if (!string.IsNullOrEmpty(msg.SomaticText))
                        {
                            <div class="somatic-tag">*@msg.SomaticText*</div>
                        }
                    }
                    <div class="dialogue-text">@msg.Dialogue</div>
                    @if (!string.IsNullOrEmpty(msg.BondDeltaText))
                    {
                        <div class="bond-badge">🔗 Bond Shift: @msg.BondDeltaText</div>
                    }
                </div>
            }
        </div>

        <!-- PLAYER PROMPT INPUT -->
        <div class="player-input-bar">
            <input class="input-box" placeholder="Type prompt or command (e.g. /step, /adult)..." @bind="_playerInput" @bind:event="oninput" @onkeyup="OnPlayerInputKeyUp" />
            <button class="btn btn-primary" @onclick="SendPlayerInput">Send ➔</button>
        </div>
    </div>

    <!-- RIGHT PANEL: TABBED CHARACTER A, CHARACTER B & TURN HISTORY -->
    <div class="character-panel character-panel-right">
        <!-- TAB HEADER -->
        <div class="panel-tabs-header">
            <button class="panel-tab-btn @(_rightPanelTab == "CharA" ? "active" : "")" @onclick='() => _rightPanelTab = "CharA"'>
                👤 CHARACTER A
            </button>
            <button class="panel-tab-btn @(_rightPanelTab == "CharB" ? "active" : "")" @onclick='() => _rightPanelTab = "CharB"'>
                👤 CHARACTER B
            </button>
            <button class="panel-tab-btn @(_rightPanelTab == "History" ? "active" : "")" @onclick='() => _rightPanelTab = "History"'>
                📜 HISTORY
            </button>
        </div>

        @if (_rightPanelTab == "CharA")
        {
            <div style="display: flex; flex-direction: column; gap: 0.6rem; overflow-y: auto; max-height: calc(100vh - 160px); padding-right: 0.25rem;">
                <!-- TOP CHARACTER A SELECTOR -->
                <div style="background: #0f172a; border: 1px solid var(--accent-blue); border-radius: 6px; padding: 0.5rem;">
                    <label class="form-label" style="font-size: 0.68rem; color: var(--accent-blue); font-weight: 700; margin-bottom: 0.25rem;">📂 LOAD CHARACTER A CARD:</label>
                    <CustomSelect Value="@_selectedCharAFile" ValueChanged='(val => SelectCharacterCard("Slot A", val))' Options="_characterDropdownOptions" />
                </div>

                @if (!_isCharALoaded)
                {
                    <div class="canvas-fallback" style="padding: 2rem 1rem; text-align: center; border: 1px dashed var(--border-color); border-radius: 8px;">
                        <div class="canvas-avatar-icon" style="font-size: 2.5rem; margin-bottom: 0.5rem;">👤</div>
                        <div class="canvas-char-name" style="color: var(--accent-amber); font-weight: 700;">No Character Selected</div>
                        <div class="canvas-bio" style="font-size: 0.72rem; color: var(--text-muted); margin-top: 0.5rem;">
                            Select a character card from the dropdown above to load Character A onto the stage.
                        </div>
                    </div>
                }
                else
                {
                    <div style="border: 1px solid var(--border-highlight); border-radius: 6px; padding: 0.6rem; background: #0f172a;">
                        <div class="portrait-container">
                            @if (!string.IsNullOrEmpty(_charAAvatarPath) && (System.IO.File.Exists(_charAAvatarPath) || _charAAvatarPath.StartsWith("http")))
                            {
                                <img class="portrait-img" src="@_charAAvatarPath" alt="@_charAName" />
                            }
                            else
                            {
                                <div class="canvas-fallback">
                                    <div class="canvas-avatar-icon">👤</div>
                                    <div class="canvas-char-name">@_charAName @(_charAAge > 0 ? $"({_charAAge})" : "")</div>
                                </div>
                            }
                            <button class="btn btn-secondary" style="width: 100%; margin-top: 0.4rem; font-size: 0.7rem; padding: 0.25rem;" @onclick='() => OpenGeneratePortraitModal("Slot A")'>✨ Generate AI Art</button>
                        </div>

                        <!-- DESCRIPTION -->
                        <div style="margin-top: 0.6rem;">
                            <div style="font-size: 0.68rem; font-weight: 700; color: var(--accent-blue); text-transform: uppercase; margin-bottom: 0.2rem;">📖 Persona & Description</div>
                            <div style="font-size: 0.72rem; color: var(--text-secondary); line-height: 1.4; background: rgba(0,0,0,0.25); padding: 0.4rem; border-radius: 4px;">
                                @_charADescription
                            </div>
                        </div>

                        <!-- GOALS -->
                        @if (_charAGoals != null && _charAGoals.Count > 0)
                        {
                            <div style="margin-top: 0.6rem;">
                                <div style="font-size: 0.68rem; font-weight: 700; color: var(--accent-amber); text-transform: uppercase; margin-bottom: 0.2rem;">🎯 Active Goals</div>
                                <div style="display: flex; flex-direction: column; gap: 0.2rem;">
                                    @foreach (var g in _charAGoals)
                                    {
                                        <div style="font-size: 0.68rem; color: var(--text-primary); background: rgba(245,158,11,0.08); border-left: 2px solid var(--accent-amber); padding: 0.2rem 0.4rem; border-radius: 2px;">
                                            • @g
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        <!-- LIKES & SKILLS -->
                        @if (_charASkills != null && _charASkills.Count > 0)
                        {
                            <div style="margin-top: 0.6rem;">
                                <div style="font-size: 0.68rem; font-weight: 700; color: var(--accent-purple); text-transform: uppercase; margin-bottom: 0.25rem;">✨ Likes & Specializations</div>
                                <div style="display: flex; flex-wrap: wrap; gap: 0.25rem;">
                                    @foreach (var s in _charASkills)
                                    {
                                        <span style="background: #1e1b4b; color: #c084fc; border: 1px solid rgba(192,132,252,0.3); font-size: 0.65rem; padding: 0.15rem 0.4rem; border-radius: 4px;">
                                            @s
                                        </span>
                                    }
                                </div>
                            </div>
                        }

                        <!-- TELEMETRY -->
                        <div class="telemetry-section" style="margin-top: 0.6rem;">
                            <div class="meter-group">
                                <div class="meter-header">
                                    <span>STRESS TELEMETRY</span>
                                    <span style="color: var(--accent-amber);">@_charAStress / 100</span>
                                </div>
                                <div class="meter-bar">
                                    <div class="meter-fill-stress" style="width: @(_charAStress)%"></div>
                                </div>
                            </div>
                            <div class="meter-group">
                                <div class="meter-header">
                                    <span>AROUSAL TELEMETRY</span>
                                    <span style="color: var(--accent-purple);">@_charAArousal / 100</span>
                                </div>
                                <div class="meter-bar">
                                    <div class="meter-fill-arousal" style="width: @(_charAArousal)%"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else if (_rightPanelTab == "CharB")
        {
            <div style="display: flex; flex-direction: column; gap: 0.6rem; overflow-y: auto; max-height: calc(100vh - 160px); padding-right: 0.25rem;">
                <!-- TOP CHARACTER B SELECTOR -->
                <div style="background: #0f172a; border: 1px solid var(--accent-purple); border-radius: 6px; padding: 0.5rem;">
                    <label class="form-label" style="font-size: 0.68rem; color: var(--accent-purple); font-weight: 700; margin-bottom: 0.25rem;">📂 LOAD CHARACTER B CARD:</label>
                    <CustomSelect Value="@_selectedCharBFile" ValueChanged='(val => SelectCharacterCard("Slot B", val))' Options="_characterDropdownOptions" />
                </div>

                @if (!_isCharBLoaded)
                {
                    <div class="canvas-fallback" style="padding: 2rem 1rem; text-align: center; border: 1px dashed var(--border-color); border-radius: 8px;">
                        <div class="canvas-avatar-icon" style="font-size: 2.5rem; margin-bottom: 0.5rem;">👤</div>
                        <div class="canvas-char-name" style="color: var(--accent-amber); font-weight: 700;">No Character Selected</div>
                        <div class="canvas-bio" style="font-size: 0.72rem; color: var(--text-muted); margin-top: 0.5rem;">
                            Select a character card from the dropdown above to load Character B onto the stage.
                        </div>
                    </div>
                }
                else
                {
                    <div style="border: 1px solid var(--border-highlight); border-radius: 6px; padding: 0.6rem; background: #0f172a;">
                        <div class="portrait-container">
                            @if (!string.IsNullOrEmpty(_charBAvatarPath) && (System.IO.File.Exists(_charBAvatarPath) || _charBAvatarPath.StartsWith("http")))
                            {
                                <img class="portrait-img" src="@_charBAvatarPath" alt="@_charBName" />
                            }
                            else
                            {
                                <div class="canvas-fallback">
                                    <div class="canvas-avatar-icon">👤</div>
                                    <div class="canvas-char-name">@_charBName @(_charBAge > 0 ? $"({_charBAge})" : "")</div>
                                </div>
                            }
                            <button class="btn btn-secondary" style="width: 100%; margin-top: 0.4rem; font-size: 0.7rem; padding: 0.25rem;" @onclick='() => OpenGeneratePortraitModal("Slot B")'>✨ Generate AI Art</button>
                        </div>

                        <!-- DESCRIPTION -->
                        <div style="margin-top: 0.6rem;">
                            <div style="font-size: 0.68rem; font-weight: 700; color: var(--accent-purple); text-transform: uppercase; margin-bottom: 0.2rem;">📖 Persona & Description</div>
                            <div style="font-size: 0.72rem; color: var(--text-secondary); line-height: 1.4; background: rgba(0,0,0,0.25); padding: 0.4rem; border-radius: 4px;">
                                @_charBDescription
                            </div>
                        </div>

                        <!-- GOALS -->
                        @if (_charBGoals != null && _charBGoals.Count > 0)
                        {
                            <div style="margin-top: 0.6rem;">
                                <div style="font-size: 0.68rem; font-weight: 700; color: var(--accent-amber); text-transform: uppercase; margin-bottom: 0.2rem;">🎯 Active Goals</div>
                                <div style="display: flex; flex-direction: column; gap: 0.2rem;">
                                    @foreach (var g in _charBGoals)
                                    {
                                        <div style="font-size: 0.68rem; color: var(--text-primary); background: rgba(245,158,11,0.08); border-left: 2px solid var(--accent-amber); padding: 0.2rem 0.4rem; border-radius: 2px;">
                                            • @g
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        <!-- LIKES & SKILLS -->
                        @if (_charBSkills != null && _charBSkills.Count > 0)
                        {
                            <div style="margin-top: 0.6rem;">
                                <div style="font-size: 0.68rem; font-weight: 700; color: var(--accent-purple); text-transform: uppercase; margin-bottom: 0.25rem;">✨ Likes & Specializations</div>
                                <div style="display: flex; flex-wrap: wrap; gap: 0.25rem;">
                                    @foreach (var s in _charBSkills)
                                    {
                                        <span style="background: #1e1b4b; color: #c084fc; border: 1px solid rgba(192,132,252,0.3); font-size: 0.65rem; padding: 0.15rem 0.4rem; border-radius: 4px;">
                                            @s
                                        </span>
                                    }
                                </div>
                            </div>
                        }

                        <!-- TELEMETRY -->
                        <div class="telemetry-section" style="margin-top: 0.6rem;">
                            <div class="meter-group">
                                <div class="meter-header">
                                    <span>STRESS TELEMETRY</span>
                                    <span style="color: var(--accent-amber);">@_charBStress / 100</span>
                                </div>
                                <div class="meter-bar">
                                    <div class="meter-fill-stress" style="width: @(_charBStress)%"></div>
                                </div>
                            </div>
                            <div class="meter-group">
                                <div class="meter-header">
                                    <span>AROUSAL TELEMETRY</span>
                                    <span style="color: var(--accent-purple);">@_charBArousal / 100</span>
                                </div>
                                <div class="meter-bar">
                                    <div class="meter-fill-arousal" style="width: @(_charBArousal)%"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <!-- TURN HISTORY TAB VIEW -->
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.4rem;">
                <span class="section-title" style="margin: 0;">📜 TURN HISTORY LOG</span>
                <span style="font-size: 0.68rem; color: var(--text-muted);">Total Turns: @_dialogueFeed.Count</span>
            </div>
            <div class="output-log-container">
                @for (int i = 0; i < _dialogueFeed.Count; i++)
                {
                    var turn = _dialogueFeed[i];
                    <div style="border-bottom: 1px solid rgba(255,255,255,0.06); padding-bottom: 0.35rem; margin-bottom: 0.35rem;">
                        <div style="font-weight: 700; color: @turn.SpeakerColor; font-size: 0.7rem;">
                            Turn #@(i + 1): @turn.SpeakerName @(turn.IsSystem ? "" : $"➔ {turn.TargetName}")
                        </div>
                        <div style="font-size: 0.68rem; color: var(--text-secondary); margin-top: 0.15rem;">
                            @turn.Dialogue
                        </div>
                        @if (!string.IsNullOrEmpty(turn.BondDeltaText))
                        {
                            <div style="font-size: 0.65rem; color: var(--accent-purple); margin-top: 0.1rem;">🔗 @turn.BondDeltaText</div>
                        }
                    </div>
                }
            </div>
        }
    </div>

</div>

@if (_showGeneratePortraitModal)
{
    <GeneratePortraitModal SlotName="@_targetPortraitSlot" OnPortraitGenerated="OnPortraitGenerated" />
}

@implements IDisposable

@code {
    private string _leftPanelTab = "Scene";
    private string _rightPanelTab = "CharA";
    private bool _showGeneratePortraitModal = false;
    private string _targetPortraitSlot = "Slot A";
    private string _sceneImagePath = "";
    private bool _isGeneratingScene = false;

    private string _selectedCharAFile = "";
    private string _selectedCharBFile = "";
    private List<CustomSelect.DropdownOption> _characterDropdownOptions = new();

    private async Task GenerateSceneArtwork()
    {
        _isGeneratingScene = true;
        StateHasChanged();
        try
        {
            var engineEnum = ControlContext.CurrentSettings?.ImageEngine switch
            {
                "OllamaLocal" => CharacterSimulator.Logic.Services.ImageGeneratorEngine.OllamaLocal,
                "StableDiffusionWebUI" => CharacterSimulator.Logic.Services.ImageGeneratorEngine.StableDiffusionWebUI,
                _ => CharacterSimulator.Logic.Services.ImageGeneratorEngine.PollinationsAI
            };

            string scenePrompt = string.IsNullOrEmpty(ControlContext.CurrentSettings?.ScenePrompt)
                ? "Contemporary quiet city apartment at midnight during a rainstorm, warm interior lights, neon city view"
                : ControlContext.CurrentSettings.ScenePrompt;

            _sceneImagePath = await CharacterSimulator.Logic.Services.AiImageGeneratorService.GeneratePortraitAsync(scenePrompt, "scene_location", engineEnum);
        }
        catch { }
        finally
        {
            _isGeneratingScene = false;
            StateHasChanged();
        }
    }

    private void SelectCharacterCard(string slot, string fileName)
    {
        if (slot == "Slot A")
        {
            _selectedCharAFile = fileName;
            var info = CharacterCatalog.LoadCardDetails(fileName);
            _charAName = info.Name;
            _charAAge = info.Age;
            _charADescription = info.Description;
            _charAPhysical = info.Physical;
            _charAAvatarPath = info.AvatarPath;
            _charAGoals = info.Goals;
            _charASkills = info.Skills;
            _charAStress = 15;
            _charAArousal = 10;
            _outputLogs.Add(new LogEntryModel { Timestamp = DateTime.Now, Message = $"Loaded Character A card: {info.Name} ({fileName})", LevelClass = "log-success" });
            _dialogueFeed.Add(new ChatMessageModel { SpeakerName = "System", Dialogue = $"🎭 {info.Name} loaded into Character A slot.", IsSystem = true });
        }
        else
        {
            _selectedCharBFile = fileName;
            var info = CharacterCatalog.LoadCardDetails(fileName);
            _charBName = info.Name;
            _charBAge = info.Age;
            _charBDescription = info.Description;
            _charBPhysical = info.Physical;
            _charBAvatarPath = info.AvatarPath;
            _charBGoals = info.Goals;
            _charBSkills = info.Skills;
            _charBStress = 20;
            _charBArousal = 15;
            _outputLogs.Add(new LogEntryModel { Timestamp = DateTime.Now, Message = $"Loaded Character B card: {info.Name} ({fileName})", LevelClass = "log-success" });
            _dialogueFeed.Add(new ChatMessageModel { SpeakerName = "System", Dialogue = $"🎭 {info.Name} loaded into Character B slot.", IsSystem = true });
        }
        StateHasChanged();
    }

    private bool _isCharALoaded => !string.IsNullOrEmpty(_charAName) && _charAName != "(No Character Selected)";
    private bool _isCharBLoaded => !string.IsNullOrEmpty(_charBName) && _charBName != "(No Character Selected)";
    private bool IsAnyCharacterLoaded => _isCharALoaded || _isCharBLoaded;

    private List<LogEntryModel> _outputLogs = new()
    {
        new LogEntryModel { Timestamp = DateTime.Now, Message = "System initialized. Blazor Desktop runtime ready.", LevelClass = "log-info" },
        new LogEntryModel { Timestamp = DateTime.Now, Message = "SystemLeakLinter loaded. Output hygiene active.", LevelClass = "log-success" },
        new LogEntryModel { Timestamp = DateTime.Now, Message = "Execution mode set to Player-Guided Mode.", LevelClass = "log-warning" }
    };

    private string _charAName = "(No Character Selected)";
    private int _charAAge = 0;
    private string _charADescription = "No character card loaded.";
    private string _charAPhysical = "";
    private string _charAAvatarPath = "";
    private int _charAStress = 0;
    private int _charAArousal = 0;
    private List<string> _charAGoals = new();
    private List<string> _charASkills = new();

    private string _charBName = "(No Character Selected)";
    private int _charBAge = 0;
    private string _charBDescription = "No character card loaded.";
    private string _charBPhysical = "";
    private string _charBAvatarPath = "";
    private int _charBStress = 0;
    private int _charBArousal = 0;
    private List<string> _charBGoals = new();
    private List<string> _charBSkills = new();

    private string _playerInput = "";
    private List<ChatMessageModel> _dialogueFeed = new()
    {
        new ChatMessageModel { SpeakerName = "System", Dialogue = "Stage initialized (No Characters Loaded). Open File ➔ Simulation Setup to assign characters.", IsSystem = true }
    };

    protected override void OnInitialized()
    {
        ControlContext.OnUIUpdated += OnBackgroundAutoRefresh;
        ControlContext.OnSettingsChanged += OnSettingsUpdated;

        var catalog = CharacterCatalog.ListCardFileNames();
        _characterDropdownOptions = new List<CustomSelect.DropdownOption>
        {
            new("", "(No Character Selected)")
        };
        foreach (var card in catalog)
        {
            _characterDropdownOptions.Add(new(card, card));
        }

        if (catalog.Count > 0)
        {
            SelectCharacterCard("Slot A", catalog[0]);
        }

        if (ControlContext.CurrentSettings != null)
        {
            OnSettingsUpdated(ControlContext.CurrentSettings);
        }
    }

    public void Dispose()
    {
        ControlContext.OnUIUpdated -= OnBackgroundAutoRefresh;
        ControlContext.OnSettingsChanged -= OnSettingsUpdated;
    }

    private void OnSettingsUpdated(AppSettings settings)
    {
        InvokeAsync(() =>
        {
            _outputLogs.Add(new LogEntryModel
            {
                Timestamp = DateTime.Now,
                Message = $"⚙️ Engine Settings Active — Roleplay: {settings.RoleplayLlmProvider} ({settings.RoleplayModelIdentifier}) | Image: {settings.ImageEngine} ({settings.ImageResolution}) | Mode: {settings.RoleplayMode}",
                LevelClass = "log-info"
            });
            StateHasChanged();
        });
    }

    private void OnBackgroundAutoRefresh()
    {
        InvokeAsync(() =>
        {
            var catalog = CharacterCatalog.ListCardFileNames();
            _characterDropdownOptions = new List<CustomSelect.DropdownOption>
            {
                new("", "(No Character Selected)")
            };
            foreach (var card in catalog)
            {
                _characterDropdownOptions.Add(new(card, card));
            }

            if (!string.IsNullOrEmpty(_selectedCharAFile))
            {
                SelectCharacterCard("Slot A", _selectedCharAFile);
            }
            if (!string.IsNullOrEmpty(_selectedCharBFile))
            {
                SelectCharacterCard("Slot B", _selectedCharBFile);
            }

            _outputLogs.Add(new LogEntryModel
            {
                Timestamp = DateTime.Now,
                Message = "🔄 Complete UI refresh executed. Re-scanned character cards and configuration from disk.",
                LevelClass = "log-success"
            });

            StateHasChanged();
            _ = JS.InvokeVoidAsync("scrollFeedToBottom", "dialogueFeed");
        });
    }

    private void OpenGeneratePortraitModal(string slotName)
    {
        _targetPortraitSlot = slotName;
        _showGeneratePortraitModal = true;
    }

    private void OnPortraitGenerated(string path)
    {
        _showGeneratePortraitModal = false;
        if (!string.IsNullOrEmpty(path))
        {
            if (_targetPortraitSlot == "Slot A")
            {
                _charAAvatarPath = path;
            }
            else
            {
                _charBAvatarPath = path;
            }
            StateHasChanged();
        }
    }

    private void OnPlayerInputKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            SendPlayerInput();
        }
    }

    private void SendPlayerInput()
    {
        if (string.IsNullOrWhiteSpace(_playerInput)) return;

        _dialogueFeed.Add(new ChatMessageModel
        {
            SpeakerName = "Player",
            TargetName = "All",
            Dialogue = _playerInput,
            SpeakerColor = "#34D399",
            IsLeft = true,
            SpeakerEmotionEmoji = "💬"
        });

        _playerInput = "";
        InvokeAsync(async () =>
        {
            StateHasChanged();
            await JS.InvokeVoidAsync("scrollFeedToBottom", "dialogueFeed");
        });
    }

    private void ClearLogs()
    {
        _outputLogs.Clear();
        _outputLogs.Add(new LogEntryModel { Timestamp = DateTime.Now, Message = "Log cleared by user.", LevelClass = "log-info" });
    }

    public record GoalItem(string Name, string Description);

    public class LogEntryModel
    {
        public DateTime Timestamp { get; set; } = DateTime.Now;
        public string Message { get; set; } = "";
        public string LevelClass { get; set; } = "log-info";
    }

    public class ChatMessageModel
    {
        public string SpeakerName { get; set; } = "";
        public string TargetName { get; set; } = "";
        public string Dialogue { get; set; } = "";
        public string SomaticText { get; set; } = "";
        public string BondDeltaText { get; set; } = "";
        public string SpeakerEmotionEmoji { get; set; } = "💬";
        public string SpeakerColor { get; set; } = "#38BDF8";
        public bool IsLeft { get; set; } = true;
        public bool IsSystem { get; set; } = false;
    }
}
