@page "/"
@inject TurnControlContext ControlContext
@inject IJSRuntime JS

<div class="workspace-grid">
    
    <!-- LEFT PANEL: SYSTEM DIAGNOSTICS & OUTPUT LOG -->
    <div class="character-panel">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
            <span class="section-title" style="margin: 0; color: var(--accent-blue);">📜 DIAGNOSTICS & OUTPUT LOG</span>
            <button class="btn btn-secondary" style="padding: 0.15rem 0.4rem; font-size: 0.65rem;" @onclick="ClearLogs">Clear</button>
        </div>
        <div class="output-log-container" id="outputLogBox">
            @foreach (var entry in _outputLogs)
            {
                <div class="log-entry @entry.LevelClass">
                    <span class="log-time">[@entry.Timestamp.ToString("HH:mm:ss")]</span>
                    <span>@entry.Message</span>
                </div>
            }
        </div>
    </div>

    <!-- CENTER PANEL: DIALOGUE FEED -->
    <div class="feed-panel">
        <div class="feed-messages" id="dialogueFeed">
            @foreach (var msg in _dialogueFeed)
            {
                <div class="chat-bubble @(msg.IsSystem ? "chat-system" : (msg.IsLeft ? "chat-left" : "chat-right"))">
                    @if (!msg.IsSystem)
                    {
                        <div class="chat-header">
                            <span class="speaker-name" style="color: @msg.SpeakerColor;">@msg.SpeakerName ➔ @msg.TargetName</span>
                            <span>@msg.SpeakerEmotionEmoji</span>
                        </div>
                        @if (!string.IsNullOrEmpty(msg.SomaticText))
                        {
                            <div class="somatic-tag">*@msg.SomaticText*</div>
                        }
                    }
                    <div class="dialogue-text">@msg.Dialogue</div>
                    @if (!string.IsNullOrEmpty(msg.BondDeltaText))
                    {
                        <div class="bond-badge">🔗 Bond Shift: @msg.BondDeltaText</div>
                    }
                </div>
            }
        </div>

        <!-- PLAYER PROMPT INPUT -->
        <div class="player-input-bar">
            <input class="input-box" placeholder="Type prompt or command (e.g. /step, /adult)..." @bind="_playerInput" @bind:event="oninput" @onkeyup="OnPlayerInputKeyUp" />
            <button class="btn btn-primary" @onclick="SendPlayerInput">Send ➔</button>
        </div>
    </div>

    <!-- RIGHT PANEL: TABBED CHARACTER CARDS & TURN HISTORY -->
    <div class="character-panel character-panel-right">
        <!-- TAB HEADER -->
        <div class="panel-tabs-header">
            <button class="panel-tab-btn @(_rightPanelTab == "Character" ? "active" : "")" @onclick='() => _rightPanelTab = "Character"'>
                🖼️ CHARACTER CARDS
            </button>
            <button class="panel-tab-btn @(_rightPanelTab == "History" ? "active" : "")" @onclick='() => _rightPanelTab = "History"'>
                📜 TURN HISTORY
            </button>
        </div>

        @if (_rightPanelTab == "Character")
        {
            @if (!IsAnyCharacterLoaded)
            {
                <div class="canvas-fallback" style="padding: 2rem 1rem; text-align: center; border: 1px dashed var(--border-color); border-radius: 8px;">
                    <div class="canvas-avatar-icon" style="font-size: 2.5rem; margin-bottom: 0.5rem;">🎭</div>
                    <div class="canvas-char-name" style="color: var(--accent-amber); font-weight: 700;">No Character Loaded</div>
                    <div class="canvas-bio" style="font-size: 0.72rem; color: var(--text-muted); margin-top: 0.5rem;">
                        No character card is assigned to the active stage.<br/>
                        Click <b>File ➔ Simulation Setup</b> to load character cards.
                    </div>
                </div>
            }
            else
            {
                <div style="display: flex; flex-direction: column; gap: 1rem;">
                    @if (_isCharALoaded)
                    {
                        <div style="border: 1px solid var(--border-highlight); border-radius: 6px; padding: 0.5rem; background: #0f172a;">
                            <div class="portrait-container">
                                @if (!string.IsNullOrEmpty(_charAAvatarPath) && (System.IO.File.Exists(_charAAvatarPath) || _charAAvatarPath.StartsWith("http")))
                                {
                                    <img class="portrait-img" src="@_charAAvatarPath" alt="@_charAName" />
                                }
                                else
                                {
                                    <div class="canvas-fallback">
                                        <div class="canvas-avatar-icon">👤</div>
                                        <div class="canvas-char-name">@_charAName</div>
                                        <div class="canvas-bio">@_charABio</div>
                                    </div>
                                }
                                <button class="btn btn-secondary" style="width: 100%; margin-top: 0.4rem; font-size: 0.7rem; padding: 0.25rem;" @onclick='() => OpenGeneratePortraitModal("Slot A")'>✨ Generate AI Art</button>
                            </div>

                            <div class="telemetry-section" style="margin-top: 0.5rem;">
                                <div class="meter-group">
                                    <div class="meter-header">
                                        <span>STRESS TELEMETRY</span>
                                        <span style="color: var(--accent-amber);">@_charAStress / 100</span>
                                    </div>
                                    <div class="meter-bar">
                                        <div class="meter-fill-stress" style="width: @(_charAStress)%"></div>
                                    </div>
                                </div>
                                <div class="meter-group">
                                    <div class="meter-header">
                                        <span>AROUSAL TELEMETRY</span>
                                        <span style="color: var(--accent-purple);">@_charAArousal / 100</span>
                                    </div>
                                    <div class="meter-bar">
                                        <div class="meter-fill-arousal" style="width: @(_charAArousal)%"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    @if (_isCharBLoaded)
                    {
                        <div style="border: 1px solid var(--border-highlight); border-radius: 6px; padding: 0.5rem; background: #0f172a;">
                            <div class="portrait-container">
                                @if (!string.IsNullOrEmpty(_charBAvatarPath) && (System.IO.File.Exists(_charBAvatarPath) || _charBAvatarPath.StartsWith("http")))
                                {
                                    <img class="portrait-img" src="@_charBAvatarPath" alt="@_charBName" />
                                }
                                else
                                {
                                    <div class="canvas-fallback">
                                        <div class="canvas-avatar-icon">👤</div>
                                        <div class="canvas-char-name">@_charBName</div>
                                        <div class="canvas-bio">@_charBBio</div>
                                    </div>
                                }
                                <button class="btn btn-secondary" style="width: 100%; margin-top: 0.4rem; font-size: 0.7rem; padding: 0.25rem;" @onclick='() => OpenGeneratePortraitModal("Slot B")'>✨ Generate AI Art</button>
                            </div>

                            <div class="telemetry-section" style="margin-top: 0.5rem;">
                                <div class="meter-group">
                                    <div class="meter-header">
                                        <span>STRESS TELEMETRY</span>
                                        <span style="color: var(--accent-amber);">@_charBStress / 100</span>
                                    </div>
                                    <div class="meter-bar">
                                        <div class="meter-fill-stress" style="width: @(_charBStress)%"></div>
                                    </div>
                                </div>
                                <div class="meter-group">
                                    <div class="meter-header">
                                        <span>AROUSAL TELEMETRY</span>
                                        <span style="color: var(--accent-purple);">@_charBArousal / 100</span>
                                    </div>
                                    <div class="meter-bar">
                                        <div class="meter-fill-arousal" style="width: @(_charBArousal)%"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        }
        else
        {
            <!-- TURN HISTORY TAB VIEW -->
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.4rem;">
                <span class="section-title" style="margin: 0;">📜 TURN HISTORY LOG</span>
                <span style="font-size: 0.68rem; color: var(--text-muted);">Total Turns: @_dialogueFeed.Count</span>
            </div>
            <div class="output-log-container">
                @for (int i = 0; i < _dialogueFeed.Count; i++)
                {
                    var turn = _dialogueFeed[i];
                    <div style="border-bottom: 1px solid rgba(255,255,255,0.06); padding-bottom: 0.35rem; margin-bottom: 0.35rem;">
                        <div style="font-weight: 700; color: @turn.SpeakerColor; font-size: 0.7rem;">
                            Turn #@(i + 1): @turn.SpeakerName @(turn.IsSystem ? "" : $"➔ {turn.TargetName}")
                        </div>
                        <div style="font-size: 0.68rem; color: var(--text-secondary); margin-top: 0.15rem;">
                            @turn.Dialogue
                        </div>
                        @if (!string.IsNullOrEmpty(turn.BondDeltaText))
                        {
                            <div style="font-size: 0.65rem; color: var(--accent-purple); margin-top: 0.1rem;">🔗 @turn.BondDeltaText</div>
                        }
                    </div>
                }
            </div>
        }
    </div>

</div>

@if (_showGeneratePortraitModal)
{
    <GeneratePortraitModal SlotName="@_targetPortraitSlot" OnPortraitGenerated="OnPortraitGenerated" />
}

@implements IDisposable

@code {
    private string _rightPanelTab = "Character";
    private bool _showGeneratePortraitModal = false;
    private string _targetPortraitSlot = "Slot A";

    private bool _isCharALoaded => !string.IsNullOrEmpty(_charAName) && _charAName != "(No Character Selected)";
    private bool _isCharBLoaded => !string.IsNullOrEmpty(_charBName) && _charBName != "(No Character Selected)";
    private bool IsAnyCharacterLoaded => _isCharALoaded || _isCharBLoaded;

    private List<LogEntryModel> _outputLogs = new()
    {
        new LogEntryModel { Timestamp = DateTime.Now, Message = "System initialized. Blazor Desktop runtime ready.", LevelClass = "log-info" },
        new LogEntryModel { Timestamp = DateTime.Now, Message = "SystemLeakLinter loaded. Output hygiene active.", LevelClass = "log-success" },
        new LogEntryModel { Timestamp = DateTime.Now, Message = "Execution mode set to Player-Guided Mode.", LevelClass = "log-warning" }
    };

    private string _charAName = "(No Character Selected)";
    private string _charABio = "No character card assigned to Slot A. Open File ➔ Simulation Setup to select a character.";
    private string _charAAvatarPath = "";
    private int _charAStress = 0;
    private int _charAArousal = 0;
    private List<GoalItem> _charAGoals = new();
    private List<string> _charASkills = new();

    private string _charBName = "(No Character Selected)";
    private string _charBBio = "No character card assigned to Slot B. Open File ➔ Simulation Setup to select a character.";
    private string _charBAvatarPath = "";
    private int _charBStress = 0;
    private int _charBArousal = 0;
    private List<GoalItem> _charBGoals = new();
    private List<string> _charBSkills = new();

    private string _playerInput = "";
    private List<ChatMessageModel> _dialogueFeed = new()
    {
        new ChatMessageModel { SpeakerName = "System", Dialogue = "Stage initialized (No Characters Loaded). Open File ➔ Simulation Setup to assign characters.", IsSystem = true }
    };

    protected override void OnInitialized()
    {
        ControlContext.OnUIUpdated += OnBackgroundAutoRefresh;
    }

    public void Dispose()
    {
        ControlContext.OnUIUpdated -= OnBackgroundAutoRefresh;
    }

    private void OnBackgroundAutoRefresh()
    {
        InvokeAsync(() =>
        {
            StateHasChanged();
            _ = JS.InvokeVoidAsync("scrollFeedToBottom", "dialogueFeed");
        });
    }

    private void OpenGeneratePortraitModal(string slotName)
    {
        _targetPortraitSlot = slotName;
        _showGeneratePortraitModal = true;
    }

    private void OnPortraitGenerated(string path)
    {
        _showGeneratePortraitModal = false;
        if (!string.IsNullOrEmpty(path))
        {
            if (_targetPortraitSlot == "Slot A")
            {
                _charAAvatarPath = path;
            }
            else
            {
                _charBAvatarPath = path;
            }
            StateHasChanged();
        }
    }

    private void OnPlayerInputKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            SendPlayerInput();
        }
    }

    private void SendPlayerInput()
    {
        if (string.IsNullOrWhiteSpace(_playerInput)) return;

        _dialogueFeed.Add(new ChatMessageModel
        {
            SpeakerName = "Player",
            TargetName = "All",
            Dialogue = _playerInput,
            SpeakerColor = "#34D399",
            IsLeft = true,
            SpeakerEmotionEmoji = "💬"
        });

        _playerInput = "";
        InvokeAsync(async () =>
        {
            StateHasChanged();
            await JS.InvokeVoidAsync("scrollFeedToBottom", "dialogueFeed");
        });
    }

    private void ClearLogs()
    {
        _outputLogs.Clear();
        _outputLogs.Add(new LogEntryModel { Timestamp = DateTime.Now, Message = "Log cleared by user.", LevelClass = "log-info" });
    }

    public record GoalItem(string Name, string Description);

    public class LogEntryModel
    {
        public DateTime Timestamp { get; set; } = DateTime.Now;
        public string Message { get; set; } = "";
        public string LevelClass { get; set; } = "log-info";
    }

    public class ChatMessageModel
    {
        public string SpeakerName { get; set; } = "";
        public string TargetName { get; set; } = "";
        public string Dialogue { get; set; } = "";
        public string SomaticText { get; set; } = "";
        public string BondDeltaText { get; set; } = "";
        public string SpeakerEmotionEmoji { get; set; } = "💬";
        public string SpeakerColor { get; set; } = "#38BDF8";
        public bool IsLeft { get; set; } = true;
        public bool IsSystem { get; set; } = false;
    }
}
