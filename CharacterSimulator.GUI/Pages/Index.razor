@page "/"
@using CharacterSimulator.Logic.Services
@inject TurnControlContext ControlContext
@inject SimulationHost SimHost
@inject IJSRuntime JS
@implements IDisposable

<div class="workspace-grid">
    <ImageRail
        SceneImagePath="@_sceneImagePath"
        GenreDisplayName="@SceneGenreCatalog.GetById(_selectedGenre).DisplayName"
        SceneLocationText="@_sceneLocationText"
        IsGeneratingScene="@_isGeneratingScene"
        IsCharacterLoaded="@_isCharacterLoaded"
        CharName="@_charName"
        CharAge="@_charAge"
        CharAvatarPath="@_charAvatarPath"
        OnGenerateScene="GenerateSceneArtwork"
        OnGeneratePortrait="OpenPortraitFromRail" />

    <DialoguePanel
        CenterTab="@_centerTab"
        CenterTabChanged="SwitchCenterTab"
        DialogueFeed="@_dialogueFeed"
        OutputLogs="@_outputLogs"
        PlayerInput="@_playerInput"
        PlayerInputChanged="v => _playerInput = v"
        OnSend="SendPlayerInput"
        OnClearLogs="ClearLogs"
        OnPlayerKeyUp="OnPlayerInputKeyUp" />

    <ControlRail
        IsCharacterLoaded="@_isCharacterLoaded"
        CharName="@_charName"
        SelectedCharFile="@_selectedCharFile"
        CharacterOptions="@_characterDropdownOptions"
        OnCharacterSelected="file => SelectCharacter(file, autoPlay: true)"
        OnClearCharacter="ClearCharacter"
        DetailTab="@_charDetailTab"
        DetailTabChanged="v => _charDetailTab = v"
        Personality="@_charPersonality"
        PersonalityChanged="v => _charPersonality = v"
        Behavior="@_charBehavior"
        BehaviorChanged="v => _charBehavior = v"
        Physical="@_charPhysical"
        PhysicalChanged="v => _charPhysical = v"
        Style="@_charStyle"
        StyleChanged="v => _charStyle = v"
        SelectedGenre="@_selectedGenre"
        GenreOptions="@_genreOptions"
        OnGenreChanged="OnGenreChanged"
        SceneLocationText="@_sceneLocationText"
        SceneLocationTextChanged="v => _sceneLocationText = v"
        OnLocationBlur="PersistSceneFields"
        IsGeneratingLocation="@_isGeneratingLocation"
        OnGenerateAiLocation="GenerateAiLocationAsync"
        OnApplyGenrePreset="ApplyGenrePreset"
        OnPersistScene="PersistSceneFields" />
</div>

@if (_showGeneratePortraitModal)
{
    <GeneratePortraitModal SlotName="Character" CharacterAppearance="@_portraitAppearance" CardFileName="@_portraitCardFile" OnPortraitGenerated="OnPortraitGenerated" />
}

@code {
    private string _centerTab = "Dialogue";
    private string _charDetailTab = "Personality";
    private bool _showGeneratePortraitModal;
    private string _portraitAppearance = "";
    private string _portraitCardFile = "";
    private string _sceneImagePath = "";
    private bool _isGeneratingScene;
    private bool _isGeneratingLocation;

    private string _selectedGenre = SceneGenreCatalog.DefaultGenreId;
    private string _sceneLocationText = "";
    private List<CustomSelect.DropdownOption> _genreOptions = new();
    private bool _suppressScenePersist;

    private string _selectedCharFile = "";
    private string _charName = "(No Character Selected)";
    private int _charAge;
    private string _charPersonality = "No character card loaded.";
    private string _charBehavior = "";
    private string _charPhysical = "";
    private string _charStyle = "";
    private string _charAvatarPath = "";
    private List<CustomSelect.DropdownOption> _characterDropdownOptions = new();

    private bool _isCharacterLoaded =>
        !string.IsNullOrEmpty(_charName) && _charName != "(No Character Selected)";

    private List<LogEntryModel> _outputLogs = new()
    {
        new() { Timestamp = DateTime.Now, Message = "System initialized. Blazor Desktop runtime ready.", LevelClass = "log-info" },
        new() { Timestamp = DateTime.Now, Message = "SystemLeakLinter loaded. Output hygiene active.", LevelClass = "log-success" },
        new() { Timestamp = DateTime.Now, Message = "Execution mode set to Player-Guided Mode.", LevelClass = "log-warning" },
        new() { Timestamp = DateTime.Now, Message = "Stage ready. Use the right panel to load a character.", LevelClass = "log-info" }
    };

    private string _playerInput = "";
    private List<ChatMessageModel> _dialogueFeed = new();

    private int _lastScrolledDialogueCount = -1;
    private int _lastScrolledLogCount = -1;
    private bool _pendingScrollPanels;

    protected override void OnInitialized()
    {
        ControlContext.OnUIUpdated += OnBackgroundAutoRefresh;
        ControlContext.OnSettingsChanged += OnSettingsUpdated;
        SimHost.OnDialogueLine += OnHostDialogueLine;
        SimHost.OnLog += OnHostLog;
        SimHost.OnFeedClear += OnHostFeedClear;

        _genreOptions = SceneGenreCatalog.All
            .Select(g => new CustomSelect.DropdownOption(g.Id, g.DisplayName))
            .ToList();

        var catalog = CharacterCatalog.ListCards();
        _characterDropdownOptions = new List<CustomSelect.DropdownOption>
        {
            new("", "(No Character Selected)")
        };
        foreach (var card in catalog)
            _characterDropdownOptions.Add(new(card.FileName, card.DisplayName));

        var settings = ControlContext.CurrentSettings;
        if (settings != null)
        {
            HydrateSceneFieldsFromSettings(settings);
            OnSettingsUpdated(settings);
            if (!string.IsNullOrWhiteSpace(settings.SelectedCharA)
                && !settings.SelectedCharA.StartsWith("None", StringComparison.OrdinalIgnoreCase))
            {
                _ = SelectCharacter(settings.SelectedCharA, autoPlay: false);
            }
        }
        else
        {
            _selectedGenre = SceneGenreCatalog.DefaultGenreId;
            _sceneLocationText = SceneGenreCatalog.DefaultSceneFor(_selectedGenre);
        }

        if (string.IsNullOrEmpty(_sceneImagePath))
            _ = AutoEnsureSceneArtworkAsync();
    }

    public void Dispose()
    {
        ControlContext.OnUIUpdated -= OnBackgroundAutoRefresh;
        ControlContext.OnSettingsChanged -= OnSettingsUpdated;
        SimHost.OnDialogueLine -= OnHostDialogueLine;
        SimHost.OnLog -= OnHostLog;
        SimHost.OnFeedClear -= OnHostFeedClear;
    }

    private void OpenPortraitFromRail() =>
        OpenGeneratePortraitModal(BuildPortraitAppearance(), _selectedCharFile);

    private async Task GenerateSceneArtwork()
    {
        PersistSceneFields();
        _isGeneratingScene = true;
        using var busy = BusyTaskService.BeginTask("scene_artwork", $"Rendering Scene Artwork ({SceneGenreCatalog.GetById(_selectedGenre).DisplayName})...");
        StateHasChanged();
        try
        {
            var settings = ControlContext.CurrentSettings ?? AppConfigService.LoadSettings();
            var engineEnum = ImageEngineDetector.ParseEngineId(settings?.ImageEngine);
            string imageModel = settings?.ImageModelIdentifier ?? "flux";
            string artStyleId = settings?.ImageArtStyle ?? ImageArtStyleCatalog.DefaultStyleId;

            string place = string.IsNullOrWhiteSpace(_sceneLocationText)
                ? SceneGenreCatalog.DefaultSceneFor(_selectedGenre)
                : _sceneLocationText.Trim();

            string sceneContext = SceneGenreCatalog.ComposeSceneContext(_selectedGenre, place);
            string scenePrompt = ImageArtStyleCatalog.BuildScenePrompt(
                sceneContext,
                characterName: _isCharacterLoaded ? _charName : null,
                characterDescription: null,
                characterPhysical: _isCharacterLoaded ? BuildPortraitAppearance() : null,
                artStyleId: artStyleId);

            _sceneImagePath = await AiImageGeneratorService.GeneratePortraitAsync(
                scenePrompt, "scene_location", engineEnum, imageModel,
                allowPollinationsFallback: true, artStyleId: artStyleId, applyArtStyle: false);

            await ApplySceneBackdropAsync(_sceneImagePath);

            _outputLogs.Add(new LogEntryModel
            {
                Timestamp = DateTime.Now,
                Message = $"Scene art · {SceneGenreCatalog.GetById(_selectedGenre).DisplayName} · " +
                          $"style {ImageArtStyleCatalog.GetById(artStyleId).DisplayName}" +
                          (_isCharacterLoaded ? $" · with {_charName}" : " · environment only") +
                          " · app backdrop updated",
                LevelClass = "log-success"
            });
        }
        catch (Exception ex)
        {
            _outputLogs.Add(new LogEntryModel
            {
                Timestamp = DateTime.Now,
                Message = $"Scene art failed: {ex.Message}",
                LevelClass = "log-error"
            });
        }
        finally
        {
            _isGeneratingScene = false;
            StateHasChanged();
        }
    }

    private async Task ApplySceneBackdropAsync(string? imageUrl)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(imageUrl) ||
                (!imageUrl.StartsWith("data:", StringComparison.OrdinalIgnoreCase) &&
                 !imageUrl.StartsWith("http", StringComparison.OrdinalIgnoreCase) &&
                 !File.Exists(imageUrl)))
            {
                await JS.InvokeVoidAsync("csTheme.setSceneBackdrop", "");
                return;
            }

            string cssUrl = imageUrl;
            if (!imageUrl.StartsWith("data:", StringComparison.OrdinalIgnoreCase) &&
                !imageUrl.StartsWith("http", StringComparison.OrdinalIgnoreCase) &&
                File.Exists(imageUrl))
            {
                try
                {
                    byte[] bytes = await File.ReadAllBytesAsync(imageUrl);
                    string mime = imageUrl.EndsWith(".png", StringComparison.OrdinalIgnoreCase) ? "image/png" : "image/jpeg";
                    cssUrl = $"data:{mime};base64,{Convert.ToBase64String(bytes)}";
                }
                catch { cssUrl = ""; }
            }

            await JS.InvokeVoidAsync("csTheme.setSceneBackdrop", cssUrl ?? "");
        }
        catch { }
    }

    private Task OnGenreChanged(string genreId)
    {
        _selectedGenre = SceneGenreCatalog.GetById(genreId).Id;
        if (string.IsNullOrWhiteSpace(_sceneLocationText))
            _sceneLocationText = SceneGenreCatalog.DefaultSceneFor(_selectedGenre);
        PersistSceneFields();
        StateHasChanged();
        return Task.CompletedTask;
    }

    private void ApplyGenrePreset()
    {
        _sceneLocationText = SceneGenreCatalog.DefaultSceneFor(_selectedGenre);
        PersistSceneFields();
        StateHasChanged();
    }

    private async Task GenerateAiLocationAsync()
    {
        _isGeneratingLocation = true;
        using var busy = BusyTaskService.BeginTask("ai_location", $"Generating AI Location ({SceneGenreCatalog.GetById(_selectedGenre).DisplayName})...");
        StateHasChanged();
        try
        {
            var settings = ControlContext.CurrentSettings ?? AppConfigService.LoadSettings();
            string provider = settings?.RoleplayLlmProvider ?? "Mock";
            var client = LlmDiscoveryService.CreateClient(provider);

            string genreName = SceneGenreCatalog.GetById(_selectedGenre).DisplayName;
            string prompt = $"You are a creative roleplay worldbuilder. Generate a vivid 2 to 3 sentence location and atmosphere description for a {genreName} roleplay scene. " +
                            $"Include environmental details, lighting, weather or time of day, and sensory atmosphere. " +
                            (_isCharacterLoaded ? $"The scene features {_charName}." : "") +
                            $" Do not output any preamble, commentary, markdown, or quotation marks. Output ONLY the raw description text.";

            _outputLogs.Add(new LogEntryModel
            {
                Timestamp = DateTime.Now,
                Message = $"Generating AI scene location for '{genreName}' via {provider}…",
                LevelClass = "log-info"
            });

            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(25));
            string response = await client.CompleteRawAsync(prompt, cts.Token);

            if (!string.IsNullOrWhiteSpace(response))
            {
                string cleaned = response.Trim().Trim('"', '\'', '`', '\n', '\r');
                if (cleaned.StartsWith("Location:", StringComparison.OrdinalIgnoreCase))
                    cleaned = cleaned[9..].Trim();

                if (!string.IsNullOrWhiteSpace(cleaned))
                {
                    _sceneLocationText = cleaned;
                    PersistSceneFields();
                    _outputLogs.Add(new LogEntryModel
                    {
                        Timestamp = DateTime.Now,
                        Message = $"✨ AI Scene Location generated successfully ({genreName}).",
                        LevelClass = "log-success"
                    });
                    _ = GenerateSceneArtwork();
                    return;
                }
            }

            ApplyGenrePreset();
        }
        catch (Exception ex)
        {
            _outputLogs.Add(new LogEntryModel
            {
                Timestamp = DateTime.Now,
                Message = $"AI location generation notice: {ex.Message} — applied static preset.",
                LevelClass = "log-warning"
            });
            ApplyGenrePreset();
        }
        finally
        {
            _isGeneratingLocation = false;
            StateHasChanged();
        }
    }

    private void PersistSceneFields()
    {
        if (_suppressScenePersist) return;
        try
        {
            string genre = SceneGenreCatalog.GetById(_selectedGenre).Id;
            string place = string.IsNullOrWhiteSpace(_sceneLocationText)
                ? SceneGenreCatalog.DefaultSceneFor(genre)
                : _sceneLocationText.Trim();
            _selectedGenre = genre;
            _sceneLocationText = place;

            _suppressScenePersist = true;
            ControlContext.PatchScene(genre, place);
            SimHost.SetSceneOverride(place);
        }
        catch { }
        finally
        {
            _suppressScenePersist = false;
        }
    }

    private void HydrateSceneFieldsFromSettings(AppSettings? settings)
    {
        if (settings == null) return;
        _selectedGenre = SceneGenreCatalog.GetById(settings.SelectedGenre).Id;
        _sceneLocationText = string.IsNullOrWhiteSpace(settings.ScenePrompt)
            ? SceneGenreCatalog.DefaultSceneFor(_selectedGenre)
            : settings.ScenePrompt;
    }

    private async Task SelectCharacter(string fileName, bool autoPlay = false)
    {
        if (string.IsNullOrEmpty(fileName) ||
            fileName.StartsWith('(') ||
            fileName.Equals("None", StringComparison.OrdinalIgnoreCase) ||
            fileName.Contains("No Character", StringComparison.OrdinalIgnoreCase) ||
            fileName.Contains("Not Selected", StringComparison.OrdinalIgnoreCase) ||
            fileName.StartsWith("None (", StringComparison.OrdinalIgnoreCase))
        {
            ClearCharacter();
            StateHasChanged();
            return;
        }

        if (string.Equals(_selectedCharFile, fileName, StringComparison.Ordinal) && _isCharacterLoaded)
        {
            await Task.CompletedTask;
            return;
        }

        try
        {
            var info = CharacterCatalog.LoadCardDetails(fileName);

            if (string.IsNullOrWhiteSpace(info.Name) ||
                info.Name.Equals("Unknown Character", StringComparison.OrdinalIgnoreCase) ||
                info.Description.Contains("not found", StringComparison.OrdinalIgnoreCase))
            {
                ClearCharacter();
                _outputLogs.Add(new LogEntryModel
                {
                    Timestamp = DateTime.Now,
                    Message = $"Character file not available ({fileName}) — skipped load.",
                    LevelClass = "log-info"
                });
                StateHasChanged();
                return;
            }

            _selectedCharFile = fileName;
            _charName = info.Name;
            _charAge = info.Age;
            _charPersonality = info.Personality;
            _charBehavior = info.Behavior;
            _charPhysical = info.Physical;
            _charStyle = info.CharacterStyle;
            _charAvatarPath = info.AvatarPath;

            SimHost.SetStagedCharacter(fileName);
            SaveSelectedCharacter(fileName);

            _outputLogs.Add(new LogEntryModel
            {
                Timestamp = DateTime.Now,
                Message = $"Loaded character card: {info.Name} ({fileName})",
                LevelClass = "log-success"
            });

            if (autoPlay)
            {
                _dialogueFeed.Add(new ChatMessageModel
                {
                    SpeakerName = "System",
                    Dialogue = $"🎭 {info.Name} loaded onto the stage. Auto-play starting...",
                    IsSystem = true
                });
                SimHost.Play();
            }
            else
            {
                _dialogueFeed.Add(new ChatMessageModel
                {
                    SpeakerName = "System",
                    Dialogue = $"🎭 {info.Name} loaded onto the stage. Press ▶ Play or send a line to start.",
                    IsSystem = true
                });
            }

            StateHasChanged();

            string cardId = CharacterCatalog.GetCardId(fileName);
            string avatar = ResolveStoredPortraitUri(fileName, info.AvatarPath);

            if (IsDisplayableAvatar(avatar))
                _charAvatarPath = avatar;
            else
            {
                _charAvatarPath = "";
                _ = AutoEnsurePortraitAsync(cardId, info.Physical, info.CharacterStyle);
            }

            if (string.IsNullOrEmpty(_sceneImagePath))
                _ = AutoEnsureSceneArtworkAsync();

            StateHasChanged();
        }
        catch (Exception ex)
        {
            ClearCharacter();
            _outputLogs.Add(new LogEntryModel
            {
                Timestamp = DateTime.Now,
                Message = $"Skipped character load ({fileName}): {ex.Message}",
                LevelClass = "log-error"
            });
        }

        await Task.CompletedTask;
    }

    private string ResolveStoredPortraitUri(string fileName, string catalogAvatarPath)
    {
        if (string.IsNullOrWhiteSpace(fileName)) return "";

        string cardId = CharacterCatalog.GetCardId(fileName);
        if (string.IsNullOrEmpty(cardId))
            return IsDisplayableAvatar(catalogAvatarPath) ? catalogAvatarPath : "";

        try
        {
            string? dbUri = CharacterPortraitService.TryGetStoredDataUri(cardId);
            if (!string.IsNullOrEmpty(dbUri))
                return dbUri;
        }
        catch { }

        return IsDisplayableAvatar(catalogAvatarPath) ? catalogAvatarPath : "";
    }

    private async Task AutoEnsurePortraitAsync(string cardId, string physical, string characterStyle)
    {
        if (string.IsNullOrWhiteSpace(cardId)) return;
        try
        {
            string prompt = CardFieldFormatter.BuildImagingPrompt(physical, characterStyle, _charName);
            if (string.IsNullOrWhiteSpace(prompt))
                prompt = string.IsNullOrWhiteSpace(_charName) ? "solo character portrait" : $"{_charName}, solo character portrait";

            string portraitUri = await CharacterPortraitService.EnsurePortraitAsync(cardId, prompt, generateIfMissing: true);
            if (!string.IsNullOrEmpty(portraitUri))
            {
                _charAvatarPath = portraitUri;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"[Index] Auto ensure portrait failed: {ex.Message}");
        }
    }

    private async Task AutoEnsureSceneArtworkAsync()
    {
        if (_isGeneratingScene || !string.IsNullOrEmpty(_sceneImagePath))
            return;
        try { await GenerateSceneArtwork(); }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"[Index] Auto ensure scene artwork failed: {ex.Message}");
        }
    }

    private void ClearCharacter()
    {
        bool wasLoaded = _isCharacterLoaded || !string.IsNullOrEmpty(_selectedCharFile);

        _selectedCharFile = "";
        _charName = "(No Character Selected)";
        _charAge = 0;
        _charPersonality = "No character card loaded.";
        _charBehavior = "";
        _charPhysical = "";
        _charStyle = "";
        _charAvatarPath = "";
        SimHost.SetStagedCharacter("");
        SaveSelectedCharacter("");

        if (wasLoaded)
        {
            _outputLogs.Add(new LogEntryModel
            {
                Timestamp = DateTime.Now,
                Message = "Character removed from stage.",
                LevelClass = "log-info"
            });
        }
        StateHasChanged();
    }

    private static bool IsDisplayableAvatar(string? path) =>
        !string.IsNullOrEmpty(path) &&
        (path.StartsWith("data:", StringComparison.OrdinalIgnoreCase) ||
         path.StartsWith("http", StringComparison.OrdinalIgnoreCase) ||
         File.Exists(path));

    private void OnHostDialogueLine(DialogueLine line)
    {
        InvokeAsync(() =>
        {
            _dialogueFeed.Add(new ChatMessageModel
            {
                SpeakerName = line.SpeakerName,
                TargetName = line.TargetName,
                Dialogue = line.Dialogue,
                SomaticText = line.SomaticText,
                BondDeltaText = line.BondDeltaText,
                SpeakerEmotionEmoji = line.SpeakerEmotionEmoji,
                SpeakerColor = line.SpeakerColor,
                IsLeft = line.IsLeft,
                IsSystem = line.IsSystem
            });
            RequestScrollPanels();
            StateHasChanged();
        });
    }

    private void OnHostLog(string message)
    {
        if (string.IsNullOrWhiteSpace(message)) return;
        InvokeAsync(() =>
        {
            string level = "log-info";
            if (message.Contains("ERROR", StringComparison.OrdinalIgnoreCase)
                || message.Contains("Failed", StringComparison.OrdinalIgnoreCase))
                level = "log-error";
            else if (message.Contains("⚠") || message.Contains("warn", StringComparison.OrdinalIgnoreCase))
                level = "log-warning";
            else if (message.Contains("SUCCESS", StringComparison.OrdinalIgnoreCase)
                     || message.StartsWith("▶")
                     || message.StartsWith("🎬"))
                level = "log-success";

            _outputLogs.Add(new LogEntryModel
            {
                Timestamp = DateTime.Now,
                Message = message.Length > 2000 ? message[..2000] + "…" : message,
                LevelClass = level
            });
            if (_outputLogs.Count > 500)
                _outputLogs.RemoveRange(0, _outputLogs.Count - 400);
            RequestScrollPanels();
            StateHasChanged();
        });
    }

    private void OnHostFeedClear()
    {
        InvokeAsync(() =>
        {
            _dialogueFeed.Clear();
            RequestScrollPanels();
            StateHasChanged();
        });
    }

    private void RequestScrollPanels() => _pendingScrollPanels = true;

    private void SwitchCenterTab(string tab)
    {
        _centerTab = tab;
        RequestScrollPanels();
    }

    private async Task ScrollPanelsToBottomAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("scrollPanelsToBottom",
                new[] { "dialogueFeed", "outputLogBox", "historyLogBox" });
        }
        catch { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        bool dialogueGrew = _dialogueFeed.Count != _lastScrolledDialogueCount;
        bool logGrew = _outputLogs.Count != _lastScrolledLogCount;

        if (_pendingScrollPanels || dialogueGrew || logGrew || firstRender)
        {
            _pendingScrollPanels = false;
            _lastScrolledDialogueCount = _dialogueFeed.Count;
            _lastScrolledLogCount = _outputLogs.Count;
            await ScrollPanelsToBottomAsync();
        }
    }

    private void OnSettingsUpdated(AppSettings settings)
    {
        InvokeAsync(() =>
        {
            try
            {
                if (!_suppressScenePersist)
                    HydrateSceneFieldsFromSettings(settings);

                _outputLogs.Add(new LogEntryModel
                {
                    Timestamp = DateTime.Now,
                    Message = $"⚙️ Engine Settings Active — Roleplay: {settings.RoleplayLlmProvider} ({settings.RoleplayModelIdentifier}) | Image: {settings.ImageEngine} ({settings.ImageResolution}) | Mode: {settings.RoleplayMode} | Scene: [{SceneGenreCatalog.GetById(settings.SelectedGenre).DisplayName}]",
                    LevelClass = "log-info"
                });
                RequestScrollPanels();
            }
            catch (Exception ex)
            {
                _outputLogs.Add(new LogEntryModel
                {
                    Timestamp = DateTime.Now,
                    Message = $"⚙️ Settings update error: {ex.Message}",
                    LevelClass = "log-error"
                });
            }
            StateHasChanged();
        });
    }

    private void OnBackgroundAutoRefresh()
    {
        InvokeAsync(async () =>
        {
            try
            {
                var catalog = CharacterCatalog.ListCardsFresh();
                _characterDropdownOptions = new List<CustomSelect.DropdownOption>
                {
                    new("", "(No Character Selected)")
                };
                foreach (var card in catalog)
                    _characterDropdownOptions.Add(new(card.FileName, card.DisplayName));

                string? desired = ControlContext.CurrentSettings?.SelectedCharA;
                if (string.IsNullOrWhiteSpace(desired)
                    || desired.StartsWith("None", StringComparison.OrdinalIgnoreCase))
                    desired = _selectedCharFile;

                bool desiredExists = !string.IsNullOrWhiteSpace(desired)
                    && catalog.Any(c => c.FileName == desired);

                if (desiredExists)
                {
                    if (!string.Equals(_selectedCharFile, desired, StringComparison.Ordinal)
                        || !_isCharacterLoaded)
                        await SelectCharacter(desired!, autoPlay: false);
                }
                else if (_isCharacterLoaded || !string.IsNullOrEmpty(_selectedCharFile))
                {
                    ClearCharacter();
                }

                _outputLogs.Add(new LogEntryModel
                {
                    Timestamp = DateTime.Now,
                    Message = "🔄 Complete UI refresh executed. Re-scanned character cards and configuration from disk.",
                    LevelClass = "log-success"
                });
            }
            catch (Exception ex)
            {
                _outputLogs.Add(new LogEntryModel
                {
                    Timestamp = DateTime.Now,
                    Message = $"🔄 UI refresh failed: {ex.Message}",
                    LevelClass = "log-error"
                });
                _characterDropdownOptions = new List<CustomSelect.DropdownOption>
                {
                    new("", "(No Character Selected)")
                };
            }

            RequestScrollPanels();
            StateHasChanged();
        });
    }

    private string BuildPortraitAppearance() =>
        CardFieldFormatter.BuildImagingPrompt(_charPhysical, _charStyle, _charName);

    private void OpenGeneratePortraitModal(string appearance, string cardFileName)
    {
        _portraitAppearance = appearance;
        _portraitCardFile = cardFileName;
        _showGeneratePortraitModal = true;
    }

    private void OnPortraitGenerated(string path)
    {
        _showGeneratePortraitModal = false;
        if (!string.IsNullOrEmpty(path))
        {
            _charAvatarPath = path;
            StateHasChanged();
        }
    }

    private void OnPlayerInputKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            SendPlayerInput();
    }

    private void SendPlayerInput()
    {
        if (string.IsNullOrWhiteSpace(_playerInput)) return;
        string line = _playerInput;
        _playerInput = "";
        SimHost.SubmitPlayerLine(line);
        RequestScrollPanels();
        StateHasChanged();
    }

    private void ClearLogs()
    {
        _outputLogs.Clear();
        _outputLogs.Add(new LogEntryModel { Timestamp = DateTime.Now, Message = "Log cleared by user.", LevelClass = "log-info" });
        RequestScrollPanels();
    }

    private void SaveSelectedCharacter(string fileName)
    {
        try
        {
            ControlContext.PatchSelectedCharacter(fileName);
        }
        catch (Exception ex)
        {
            _outputLogs.Add(new LogEntryModel
            {
                Timestamp = DateTime.Now,
                Message = $"Failed to save selected character: {ex.Message}",
                LevelClass = "log-error"
            });
        }
    }
}
