@page "/"
@using CharacterSimulator.Logic.Services
@inject TurnControlContext ControlContext
@inject SimulationHost SimHost
@inject IJSRuntime JS

<div class="workspace-grid">

    <!-- LEFT: images only — stage (scene) + portrait -->
    <div class="character-panel character-panel-left image-rail">
        <div class="image-block">
            <div class="image-block-label">Scene</div>
            <div class="scene-stage">
                @if (!string.IsNullOrEmpty(_sceneImagePath) && (System.IO.File.Exists(_sceneImagePath) || _sceneImagePath.StartsWith("http") || _sceneImagePath.StartsWith("data:")))
                {
                    <img class="scene-stage-img" src="@_sceneImagePath" alt="Scene Location" />
                }
                else
                {
                    <div class="scene-stage-fallback">
                        <div class="canvas-avatar-icon">🏙️</div>
                        <div class="canvas-char-name">@SceneGenreCatalog.GetById(_selectedGenre).DisplayName</div>
                        <div class="canvas-bio">
                            @(string.IsNullOrWhiteSpace(_sceneLocationText)
                                ? "Set location on the right, then generate scene art."
                                : (_sceneLocationText.Length > 100 ? _sceneLocationText[..97] + "…" : _sceneLocationText))
                        </div>
                    </div>
                }
            </div>
            <button class="btn btn-secondary scene-generate-btn" disabled="@_isGeneratingScene" @onclick="GenerateSceneArtwork">
                @(_isGeneratingScene ? "✨ Rendering Scene..." : "✨ Generate Scene Artwork")
            </button>
        </div>

        <div class="image-block">
            <div class="image-block-label">Character</div>
            <div class="char-portrait-frame image-rail-portrait">
                @if (_isCharacterLoaded && !string.IsNullOrEmpty(_charAvatarPath) && (System.IO.File.Exists(_charAvatarPath) || _charAvatarPath.StartsWith("http") || _charAvatarPath.StartsWith("data:")))
                {
                    <img class="char-portrait-img" src="@_charAvatarPath" alt="@_charName" />
                }
                else if (_isCharacterLoaded)
                {
                    <div class="scene-stage-fallback">
                        <div class="canvas-avatar-icon">👤</div>
                        <div class="canvas-char-name">@_charName @(_charAge > 0 ? $"({_charAge})" : "")</div>
                        <div class="canvas-bio">Generate a portrait from Physical + Style on the right.</div>
                    </div>
                }
                else
                {
                    <div class="scene-stage-fallback">
                        <div class="canvas-avatar-icon">👤</div>
                        <div class="canvas-char-name">No character</div>
                        <div class="canvas-bio">Select a character on the right.</div>
                    </div>
                }
            </div>
            <button class="btn btn-secondary scene-generate-btn char-portrait-generate-btn"
                    disabled="@(!_isCharacterLoaded)"
                    @onclick="() => OpenGeneratePortraitModal(BuildPortraitAppearance(), _selectedCharFile)">
                ✨ Generate Portrait
            </button>
        </div>
    </div>

    <!-- CENTER: dialogue -->
    <div class="feed-panel">
        <div class="panel-tabs-header">
            <button class="panel-tab-btn @(_centerTab == "Dialogue" ? "active" : "")" @onclick='() => SwitchCenterTab("Dialogue")'>
                💬 Dialogue
            </button>
            <button class="panel-tab-btn @(_centerTab == "System" ? "active" : "")" @onclick='() => SwitchCenterTab("System")'>
                ⚙️ System
            </button>
            <button class="panel-tab-btn @(_centerTab == "History" ? "active" : "")" @onclick='() => SwitchCenterTab("History")'>
                📜 History
            </button>
        </div>

        @if (_centerTab == "Dialogue")
        {
            <div class="feed-messages" id="dialogueFeed">
                @if (_dialogueFeed.Count == 0)
                {
                    <div class="chat-bubble chat-system">
                        <div class="dialogue-text">
                            Load a character on the right to auto-start, or restore last card then press ▶ Play.
                            Slash commands: /help /play /pause /step /stop /scene /clear /adult on
                        </div>
                    </div>
                }
                @foreach (var msg in _dialogueFeed)
                {
                    <div class="chat-bubble @(msg.IsSystem ? "chat-system" : (msg.IsLeft ? "chat-left" : "chat-right"))">
                        @if (!msg.IsSystem)
                        {
                            <div class="chat-header">
                                <span class="speaker-name" style="@(string.IsNullOrEmpty(msg.SpeakerColor) ? null : $"color:{msg.SpeakerColor}")">@msg.SpeakerName @(string.IsNullOrEmpty(msg.TargetName) ? "" : "➔ " + msg.TargetName)</span>
                                <span>@msg.SpeakerEmotionEmoji</span>
                            </div>
                            @if (!string.IsNullOrEmpty(msg.SomaticText))
                            {
                                <div class="somatic-tag" title="Somatic / body reaction">
                                    <span class="somatic-label">Somatic</span>
                                    <span class="somatic-body">@msg.SomaticText</span>
                                </div>
                            }
                        }
                        <div class="dialogue-text">@msg.Dialogue</div>
                    </div>
                }
            </div>

            <div class="player-input-bar">
                <input class="input-box" placeholder="Type prompt or command (e.g. /step, /adult)..." @bind="_playerInput" @bind:event="oninput" @onkeyup="OnPlayerInputKeyUp" />
                <button class="btn btn-primary" @onclick="SendPlayerInput">Send ➔</button>
            </div>
        }
        else if (_centerTab == "System")
        {
            <div class="panel-toolbar">
                <span class="section-title section-title-accent">⚙️ System diagnostics &amp; log</span>
                <button class="btn btn-secondary btn-sm" @onclick="ClearLogs">Clear</button>
            </div>
            <div class="output-log-container" id="outputLogBox">
                @foreach (var entry in _outputLogs)
                {
                    <div class="log-entry @entry.LevelClass">
                        <span class="log-time">[@entry.Timestamp.ToString("HH:mm:ss")]</span>
                        <span class="log-message">@entry.Message</span>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="panel-toolbar">
                <span class="section-title">📜 Turn history</span>
                <span class="panel-toolbar-meta">Total turns: @_dialogueFeed.Count</span>
            </div>
            <div class="output-log-container" id="historyLogBox">
                @for (int i = 0; i < _dialogueFeed.Count; i++)
                {
                    var turn = _dialogueFeed[i];
                    <div class="history-turn">
                        <div class="history-turn-title" style="@(string.IsNullOrEmpty(turn.SpeakerColor) ? null : $"color:{turn.SpeakerColor}")">
                            Turn #@(i + 1): @turn.SpeakerName @(turn.IsSystem ? "" : "➔ " + turn.TargetName)
                        </div>
                        @if (!string.IsNullOrEmpty(turn.SomaticText))
                        {
                            <div class="somatic-tag">
                                <span class="somatic-label">Somatic</span>
                                <span class="somatic-body">@turn.SomaticText</span>
                            </div>
                        }
                        <div class="history-turn-body">@turn.Dialogue</div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- RIGHT: character + scene controls -->
    <div class="character-panel character-panel-right control-rail">
        <div class="panel-tabs-header">
            <button class="panel-tab-btn active" type="button">
                👤 @(_isCharacterLoaded ? _charName : "Character & scene")
            </button>
        </div>

        <div class="char-stack">
            <div class="char-selector-card">
                <label class="form-label form-label-accent">📂 Character</label>
                <div class="char-selector-row">
                    <div class="u-flex-1">
                        <CustomSelect Value="@_selectedCharFile" ValueChanged='(val => SelectCharacter(val, autoPlay: true))' Options="_characterDropdownOptions" />
                    </div>
                    @if (_isCharacterLoaded)
                    {
                        <button class="btn btn-secondary btn-sm" @onclick="ClearCharacter">✕ Clear</button>
                    }
                </div>
            </div>

            <div class="char-fields char-fields-tabs control-char-fields">
                <div class="panel-tabs-header char-detail-tabs" role="tablist">
                    <button type="button" role="tab"
                            class="panel-tab-btn char-detail-tab @(_charDetailTab == "Personality" ? "active" : "") char-detail-tab-personality"
                            aria-selected="@(_charDetailTab == "Personality")"
                            disabled="@(!_isCharacterLoaded)"
                            @onclick='() => _charDetailTab = "Personality"'>
                        Personality
                    </button>
                    <button type="button" role="tab"
                            class="panel-tab-btn char-detail-tab @(_charDetailTab == "Behavior" ? "active" : "") char-detail-tab-behavior"
                            aria-selected="@(_charDetailTab == "Behavior")"
                            disabled="@(!_isCharacterLoaded)"
                            @onclick='() => _charDetailTab = "Behavior"'>
                        Behavior
                    </button>
                    <button type="button" role="tab"
                            class="panel-tab-btn char-detail-tab @(_charDetailTab == "Physical" ? "active" : "") char-detail-tab-physical"
                            aria-selected="@(_charDetailTab == "Physical")"
                            disabled="@(!_isCharacterLoaded)"
                            @onclick='() => _charDetailTab = "Physical"'>
                        Physical
                    </button>
                    <button type="button" role="tab"
                            class="panel-tab-btn char-detail-tab @(_charDetailTab == "Style" ? "active" : "") char-detail-tab-style"
                            aria-selected="@(_charDetailTab == "Style")"
                            disabled="@(!_isCharacterLoaded)"
                            @onclick='() => _charDetailTab = "Style"'>
                        Style
                    </button>
                </div>

                <div class="char-field char-field-active" role="tabpanel">
                    @if (!_isCharacterLoaded)
                    {
                        <div class="control-empty-hint">
                            Select a character to edit personality, behavior, physical appearance, and style.
                        </div>
                    }
                    else if (_charDetailTab == "Personality")
                    {
                        <textarea
                            class="char-field-input"
                            @bind="_charPersonality"
                            @bind:event="oninput"
                            placeholder="Who they are — temperament, values, social stance (not body)..."
                            title="Personality: who they are"></textarea>
                    }
                    else if (_charDetailTab == "Behavior")
                    {
                        <textarea
                            class="char-field-input"
                            @bind="_charBehavior"
                            @bind:event="oninput"
                            placeholder="How they act under pressure, trust, and routine (not appearance)..."
                            title="Behavior: how they act"></textarea>
                    }
                    else if (_charDetailTab == "Physical")
                    {
                        <textarea
                            class="char-field-input"
                            @bind="_charPhysical"
                            @bind:event="oninput"
                            placeholder="Body only — height, build, hair, eyes, skin, face, marks, movement..."
                            title="Physical appearance (body only)"></textarea>
                    }
                    else
                    {
                        <textarea
                            class="char-field-input"
                            @bind="_charStyle"
                            @bind:event="oninput"
                            placeholder="How they dress — outfits, accessories, palette, signature items..."
                            title="Style & accessories: default wardrobe"></textarea>
                    }
                </div>
            </div>

            <div class="scene-controls control-scene-block">
                <div class="scene-genre-bar">
                    <label class="scene-genre-label">Genre</label>
                    <CustomSelect Value="@_selectedGenre" ValueChanged="OnGenreChanged" Options="_genreOptions" class="scene-genre-select" />
                </div>

                <div class="scene-field scene-field-location">
                    <div class="section-title section-title-location">
                        <span>📍</span>
                        <span>Location &amp; atmosphere</span>
                    </div>
                    <textarea
                        class="form-control scene-location-input"
                        @bind="_sceneLocationText"
                        @bind:event="oninput"
                        @onfocusout="PersistSceneFields"
                        placeholder="Place, time of day, weather, sensory detail… active scene for roleplay and scene art."
                        title="Saved to settings. Used when you Play / Send and for Generate Scene Artwork."></textarea>
                    <div class="scene-location-actions">
                        <button type="button" class="btn btn-primary btn-block btn-sm" disabled="@_isGeneratingLocation" @onclick="GenerateAiLocationAsync" title="Use AI to generate a vivid location for this genre">
                            @(_isGeneratingLocation ? "✨ Generating..." : "✨ Generate AI Location")
                        </button>
                        <div class="scene-location-actions-row">
                            <button type="button" class="btn btn-secondary btn-sm" @onclick="ApplyGenrePreset" title="Fill with genre default place">
                                ⇢ Preset
                            </button>
                            <button type="button" class="btn btn-secondary btn-sm" @onclick="PersistSceneFields" title="Save genre + location">
                                💾 Save
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

@if (_showGeneratePortraitModal)
{
    <GeneratePortraitModal SlotName="Character" CharacterAppearance="@_portraitAppearance" CardFileName="@_portraitCardFile" OnPortraitGenerated="OnPortraitGenerated" />
}

@implements IDisposable

@code {
    private string _centerTab = "Dialogue";
    /// <summary>Active identity field tab: Personality | Behavior | Physical | Style</summary>
    private string _charDetailTab = "Personality";
    private bool _showGeneratePortraitModal = false;
    private string _portraitAppearance = "";
    private string _portraitCardFile = "";
    private string _sceneImagePath = "";
    private bool _isGeneratingScene = false;
    private bool _isGeneratingLocation = false;

    // Live scene (left panel) — genre + freeform location become the roleplay scene
    private string _selectedGenre = SceneGenreCatalog.DefaultGenreId;
    private string _sceneLocationText = "";
    private List<CustomSelect.DropdownOption> _genreOptions = new();
    private bool _suppressScenePersist;

    // Single character state
    private string _selectedCharFile = "";
    private string _charName = "(No Character Selected)";
    private int _charAge = 0;
    private string _charPersonality = "No character card loaded.";
    private string _charBehavior = "";
    private string _charPhysical = "";
    private string _charStyle = "";
    private string _charAvatarPath = "";
    private List<string> _charGoals = new();
    private List<string> _charSkills = new();
    private List<CustomSelect.DropdownOption> _characterDropdownOptions = new();

    private bool _isCharacterLoaded => !string.IsNullOrEmpty(_charName) && _charName != "(No Character Selected)";

    private async Task GenerateSceneArtwork()
    {
        PersistSceneFields(); // ensure typed location is saved before generate
        _isGeneratingScene = true;
        using var busy = BusyTaskService.BeginTask("scene_artwork", $"Rendering Scene Artwork ({SceneGenreCatalog.GetById(_selectedGenre).DisplayName})...");
        StateHasChanged();
        try
        {
            var settings = ControlContext.CurrentSettings ?? AppConfigService.LoadSettings();
            var engineEnum = ImageEngineDetector.ParseEngineId(settings?.ImageEngine);
            string imageModel = settings?.ImageModelIdentifier ?? "flux";
            string artStyleId = settings?.ImageArtStyle ?? ImageArtStyleCatalog.DefaultStyleId;

            string place = string.IsNullOrWhiteSpace(_sceneLocationText)
                ? SceneGenreCatalog.DefaultSceneFor(_selectedGenre)
                : _sceneLocationText.Trim();

            string sceneContext = SceneGenreCatalog.ComposeSceneContext(_selectedGenre, place);

            string scenePrompt = ImageArtStyleCatalog.BuildScenePrompt(
                sceneContext,
                characterName: _isCharacterLoaded ? _charName : null,
                characterDescription: null, // never inject personality into scene stills
                characterPhysical: _isCharacterLoaded ? BuildPortraitAppearance() : null,
                artStyleId: artStyleId);

            _sceneImagePath = await AiImageGeneratorService.GeneratePortraitAsync(
                scenePrompt,
                "scene_location",
                engineEnum,
                imageModel,
                allowPollinationsFallback: true,
                artStyleId: artStyleId,
                applyArtStyle: false);

            await ApplySceneBackdropAsync(_sceneImagePath);

            _outputLogs.Add(new LogEntryModel
            {
                Timestamp = DateTime.Now,
                Message = $"Scene art · {SceneGenreCatalog.GetById(_selectedGenre).DisplayName} · " +
                          $"style {ImageArtStyleCatalog.GetById(artStyleId).DisplayName}" +
                          (_isCharacterLoaded ? $" · with {_charName}" : " · environment only") +
                          " · app backdrop updated",
                LevelClass = "log-success"
            });
        }
        catch (Exception ex)
        {
            _outputLogs.Add(new LogEntryModel
            {
                Timestamp = DateTime.Now,
                Message = $"Scene art failed: {ex.Message}",
                LevelClass = "log-error"
            });
        }
        finally
        {
            _isGeneratingScene = false;
            StateHasChanged();
        }
    }

    /// <summary>Soft full-app atmosphere from the current scene still.</summary>
    private async Task ApplySceneBackdropAsync(string? imageUrl)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(imageUrl) ||
                (!imageUrl.StartsWith("data:", StringComparison.OrdinalIgnoreCase) &&
                 !imageUrl.StartsWith("http", StringComparison.OrdinalIgnoreCase) &&
                 !System.IO.File.Exists(imageUrl)))
            {
                await JS.InvokeVoidAsync("csTheme.setSceneBackdrop", "");
                return;
            }

            // Local file paths need a data URI for CSS background-image
            string cssUrl = imageUrl;
            if (!imageUrl.StartsWith("data:", StringComparison.OrdinalIgnoreCase) &&
                !imageUrl.StartsWith("http", StringComparison.OrdinalIgnoreCase) &&
                System.IO.File.Exists(imageUrl))
            {
                try
                {
                    byte[] bytes = await System.IO.File.ReadAllBytesAsync(imageUrl);
                    string mime = imageUrl.EndsWith(".png", StringComparison.OrdinalIgnoreCase) ? "image/png" : "image/jpeg";
                    cssUrl = $"data:{mime};base64,{Convert.ToBase64String(bytes)}";
                }
                catch
                {
                    cssUrl = "";
                }
            }

            await JS.InvokeVoidAsync("csTheme.setSceneBackdrop", cssUrl ?? "");
        }
        catch
        {
            // Backdrop is cosmetic — never break scene generation
        }
    }

    private Task OnGenreChanged(string genreId)
    {
        _selectedGenre = SceneGenreCatalog.GetById(genreId).Id;
        // If location is empty, seed a preset so the box isn't blank
        if (string.IsNullOrWhiteSpace(_sceneLocationText))
            _sceneLocationText = SceneGenreCatalog.DefaultSceneFor(_selectedGenre);
        PersistSceneFields();
        StateHasChanged();
        return Task.CompletedTask;
    }

    private void ApplyGenrePreset()
    {
        _sceneLocationText = SceneGenreCatalog.DefaultSceneFor(_selectedGenre);
        PersistSceneFields();
        StateHasChanged();
    }

    private async Task GenerateAiLocationAsync()
    {
        _isGeneratingLocation = true;
        using var busy = BusyTaskService.BeginTask("ai_location", $"Generating AI Location ({SceneGenreCatalog.GetById(_selectedGenre).DisplayName})...");
        StateHasChanged();
        try
        {
            var settings = ControlContext.CurrentSettings ?? AppConfigService.LoadSettings();
            string provider = settings?.RoleplayLlmProvider ?? "Mock";
            var client = LlmDiscoveryService.CreateClient(provider);

            string genreName = SceneGenreCatalog.GetById(_selectedGenre).DisplayName;
            string prompt = $"You are a creative roleplay worldbuilder. Generate a vivid 2 to 3 sentence location and atmosphere description for a {genreName} roleplay scene. " +
                            $"Include environmental details, lighting, weather or time of day, and sensory atmosphere. " +
                            (_isCharacterLoaded ? $"The scene features {_charName}." : "") +
                            $" Do not output any preamble, commentary, markdown, or quotation marks. Output ONLY the raw description text.";

            _outputLogs.Add(new LogEntryModel
            {
                Timestamp = DateTime.Now,
                Message = $"Generating AI scene location for '{genreName}' via {provider}…",
                LevelClass = "log-info"
            });

            using var cts = new System.Threading.CancellationTokenSource(TimeSpan.FromSeconds(25));
            string response = await client.CompleteRawAsync(prompt, cts.Token);

            if (!string.IsNullOrWhiteSpace(response))
            {
                // Clean any quotes or wrappers
                string cleaned = response.Trim().Trim('"', '\'', '`', '\n', '\r');
                if (cleaned.StartsWith("Location:", StringComparison.OrdinalIgnoreCase))
                    cleaned = cleaned[9..].Trim();

                if (!string.IsNullOrWhiteSpace(cleaned))
                {
                    _sceneLocationText = cleaned;
                    PersistSceneFields();
                    _outputLogs.Add(new LogEntryModel
                    {
                        Timestamp = DateTime.Now,
                        Message = $"✨ AI Scene Location generated successfully ({genreName}).",
                        LevelClass = "log-success"
                    });
                    _ = GenerateSceneArtwork();
                    return;
                }
            }

            // Fallback to genre preset if empty response
            ApplyGenrePreset();
        }
        catch (Exception ex)
        {
            _outputLogs.Add(new LogEntryModel
            {
                Timestamp = DateTime.Now,
                Message = $"AI location generation notice: {ex.Message} — applied static preset.",
                LevelClass = "log-warning"
            });
            ApplyGenrePreset();
        }
        finally
        {
            _isGeneratingLocation = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Genre + location text are the active scene: persisted to settings and host override.
    /// </summary>
    private void PersistSceneFields()
    {
        if (_suppressScenePersist) return;
        try
        {
            string genre = SceneGenreCatalog.GetById(_selectedGenre).Id;
            string place = string.IsNullOrWhiteSpace(_sceneLocationText)
                ? SceneGenreCatalog.DefaultSceneFor(genre)
                : _sceneLocationText.Trim();
            _selectedGenre = genre;
            _sceneLocationText = place;

            // Avoid re-entrancy loops from OnSettingsChanged → HydrateSceneFields
            _suppressScenePersist = true;
            ControlContext.PatchScene(genre, place);
            SimHost.SetSceneOverride(place);
        }
        catch { }
        finally
        {
            _suppressScenePersist = false;
        }
    }

    private void HydrateSceneFieldsFromSettings(AppSettings? settings)
    {
        if (settings == null) return;
        _selectedGenre = SceneGenreCatalog.GetById(settings.SelectedGenre).Id;
        _sceneLocationText = string.IsNullOrWhiteSpace(settings.ScenePrompt)
            ? SceneGenreCatalog.DefaultSceneFor(_selectedGenre)
            : settings.ScenePrompt;
    }

    private void ShowAddCharacter()
    {
        // Clear current character to allow loading a new one
        if (_isCharacterLoaded)
        {
            ClearCharacter();
        }
        // Focus will be handled by the dropdown itself when user clicks
    }

    /// <param name="autoPlay">
    /// True only for explicit user selection from the dropdown.
    /// Startup hydrate and catalog refresh must pass false to avoid re-entry / Play storms.
    /// </param>
    private async Task SelectCharacter(string fileName, bool autoPlay = false)
    {
        if (string.IsNullOrEmpty(fileName) ||
            fileName.StartsWith('(') ||
            fileName.Equals("None", StringComparison.OrdinalIgnoreCase) ||
            fileName.Contains("No Character", StringComparison.OrdinalIgnoreCase) ||
            fileName.Contains("Not Selected", StringComparison.OrdinalIgnoreCase) ||
            fileName.StartsWith("None (", StringComparison.OrdinalIgnoreCase))
        {
            ClearCharacter();
            StateHasChanged();
            return;
        }

        // Already on stage — do not re-save, re-log, or re-Play (prevents refresh feedback loops).
        if (string.Equals(_selectedCharFile, fileName, StringComparison.Ordinal) && _isCharacterLoaded)
        {
            await Task.CompletedTask;
            return;
        }

        try
        {
            var info = CharacterCatalog.LoadCardDetails(fileName);

            // Validate card data
            if (string.IsNullOrWhiteSpace(info.Name) ||
                info.Name.Equals("Unknown Character", StringComparison.OrdinalIgnoreCase) ||
                info.Description.Contains("not found", StringComparison.OrdinalIgnoreCase))
            {
                ClearCharacter();
                _outputLogs.Add(new LogEntryModel
                {
                    Timestamp = DateTime.Now,
                    Message = $"Character file not available ({fileName}) — skipped load.",
                    LevelClass = "log-info"
                });
                StateHasChanged();
                return;
            }

            // Load character data
            _selectedCharFile = fileName;
            _charName = info.Name;
            _charAge = info.Age;
            _charPersonality = info.Personality;
            _charBehavior = info.Behavior;
            _charPhysical = info.Physical;
            _charStyle = info.CharacterStyle;
            _charAvatarPath = info.AvatarPath;
            _charGoals = info.Goals;
            _charSkills = info.Skills;

            SimHost.SetStagedCharacter(fileName);

            // Quiet persist so next startup restores selection without firing OnUIUpdated.
            SaveSelectedCharacter(fileName);

            _outputLogs.Add(new LogEntryModel
            {
                Timestamp = DateTime.Now,
                Message = $"Loaded character card: {info.Name} ({fileName})",
                LevelClass = "log-success"
            });

            if (autoPlay)
            {
                _dialogueFeed.Add(new ChatMessageModel
                {
                    SpeakerName = "System",
                    Dialogue = $"🎭 {info.Name} loaded onto the stage. Auto-play starting...",
                    IsSystem = true
                });
                SimHost.Play();
            }
            else
            {
                _dialogueFeed.Add(new ChatMessageModel
                {
                    SpeakerName = "System",
                    Dialogue = $"🎭 {info.Name} loaded onto the stage. Press ▶ Play or send a line to start.",
                    IsSystem = true
                });
            }

            StateHasChanged();

            // Load portrait from DB, disk cache, or auto-generate if missing
            string cardId = CharacterCatalog.GetCardId(fileName);
            string avatar = ResolveStoredPortraitUri(fileName, info.AvatarPath);

            if (IsDisplayableAvatar(avatar))
            {
                _charAvatarPath = avatar;
            }
            else
            {
                _charAvatarPath = "";
                _ = AutoEnsurePortraitAsync(cardId, info.Physical, info.CharacterStyle);
            }

            // Auto-render / update scene artwork with character presence if missing or on selection
            if (string.IsNullOrEmpty(_sceneImagePath))
            {
                _ = AutoEnsureSceneArtworkAsync();
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            ClearCharacter();
            _outputLogs.Add(new LogEntryModel
            {
                Timestamp = DateTime.Now,
                Message = $"Skipped character load ({fileName}): {ex.Message}",
                LevelClass = "log-error"
            });
        }

        await Task.CompletedTask;
    }

    private string ResolveStoredPortraitUri(string fileName, string catalogAvatarPath)
    {
        if (string.IsNullOrWhiteSpace(fileName)) return "";

        string cardId = CharacterCatalog.GetCardId(fileName);
        if (string.IsNullOrEmpty(cardId)) 
            return IsDisplayableAvatar(catalogAvatarPath) ? catalogAvatarPath : "";

        try
        {
            string? dbUri = CharacterSimulator.Logic.Services.CharacterPortraitService.TryGetStoredDataUri(cardId);
            if (!string.IsNullOrEmpty(dbUri))
                return dbUri;
        }
        catch { }

        if (IsDisplayableAvatar(catalogAvatarPath))
            return catalogAvatarPath;

        return "";
    }

    private async Task AutoEnsurePortraitAsync(string cardId, string physical, string characterStyle)
    {
        if (string.IsNullOrWhiteSpace(cardId)) return;
        try
        {
            // Imaging uses body + dress only — never personality/behavior
            string prompt = CharacterSimulator.Logic.CardFieldFormatter.BuildImagingPrompt(
                physical, characterStyle, _charName);
            if (string.IsNullOrWhiteSpace(prompt))
                prompt = string.IsNullOrWhiteSpace(_charName) ? "solo character portrait" : $"{_charName}, solo character portrait";

            string portraitUri = await CharacterSimulator.Logic.Services.CharacterPortraitService.EnsurePortraitAsync(
                cardId, prompt, generateIfMissing: true);

            if (!string.IsNullOrEmpty(portraitUri))
            {
                _charAvatarPath = portraitUri;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"[Index] Auto ensure portrait failed: {ex.Message}");
        }
    }

    private async Task AutoEnsureSceneArtworkAsync()
    {
        if (_isGeneratingScene || !string.IsNullOrEmpty(_sceneImagePath))
            return;

        try
        {
            await GenerateSceneArtwork();
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"[Index] Auto ensure scene artwork failed: {ex.Message}");
        }
    }

    private void ClearCharacter()
    {
        bool wasLoaded = _isCharacterLoaded || !string.IsNullOrEmpty(_selectedCharFile);

        _selectedCharFile = "";
        _charName = "(No Character Selected)";
        _charAge = 0;
        _charPersonality = "No character card loaded.";
        _charBehavior = "";
        _charPhysical = "";
        _charStyle = "";
        _charAvatarPath = "";
        _charGoals = new();
        _charSkills = new();
        SimHost.SetStagedCharacter("");

        // Quiet clear — must not fire OnUIUpdated (would re-enter refresh → ClearCharacter).
        SaveSelectedCharacter("");

        if (wasLoaded)
        {
            _outputLogs.Add(new LogEntryModel
            {
                Timestamp = DateTime.Now,
                Message = "Character removed from stage.",
                LevelClass = "log-info"
            });
        }
        StateHasChanged();
    }

    private static bool IsDisplayableAvatar(string? path) =>
        !string.IsNullOrEmpty(path) &&
        (path.StartsWith("data:", StringComparison.OrdinalIgnoreCase) ||
         path.StartsWith("http", StringComparison.OrdinalIgnoreCase) ||
         System.IO.File.Exists(path));

    private List<LogEntryModel> _outputLogs = new()
    {
        new LogEntryModel { Timestamp = DateTime.Now, Message = "System initialized. Blazor Desktop runtime ready.", LevelClass = "log-info" },
        new LogEntryModel { Timestamp = DateTime.Now, Message = "SystemLeakLinter loaded. Output hygiene active.", LevelClass = "log-success" },
        new LogEntryModel { Timestamp = DateTime.Now, Message = "Execution mode set to Player-Guided Mode.", LevelClass = "log-warning" },
        new LogEntryModel { Timestamp = DateTime.Now, Message = "Stage ready. Use the right panel to load a character.", LevelClass = "log-info" }
    };

    private string _playerInput = "";
    private List<ChatMessageModel> _dialogueFeed = new()
    {
    };

    // Autoscroll: track counts so OnAfterRender scrolls after Blazor commits DOM.
    private int _lastScrolledDialogueCount = -1;
    private int _lastScrolledLogCount = -1;
    private bool _pendingScrollPanels;

    protected override void OnInitialized()
    {
        ControlContext.OnUIUpdated += OnBackgroundAutoRefresh;
        ControlContext.OnSettingsChanged += OnSettingsUpdated;
        SimHost.OnDialogueLine += OnHostDialogueLine;
        SimHost.OnLog += OnHostLog;
        SimHost.OnFeedClear += OnHostFeedClear;

        _genreOptions = SceneGenreCatalog.All
            .Select(g => new CustomSelect.DropdownOption(g.Id, g.DisplayName))
            .ToList();

        var catalog = CharacterCatalog.ListCards();
        _characterDropdownOptions = new List<CustomSelect.DropdownOption>
        {
            new("", "(No Character Selected)")
        };
        foreach (var card in catalog)
        {
            _characterDropdownOptions.Add(new(card.FileName, card.DisplayName));
        }

        // Restore last card onto the stage without auto-play (user starts with Play / Send).
        var settings = ControlContext.CurrentSettings;
        if (settings != null)
        {
            HydrateSceneFieldsFromSettings(settings);
            OnSettingsUpdated(settings);
            if (!string.IsNullOrWhiteSpace(settings.SelectedCharA)
                && !settings.SelectedCharA.StartsWith("None", StringComparison.OrdinalIgnoreCase))
            {
                _ = SelectCharacter(settings.SelectedCharA, autoPlay: false);
            }
        }
        else
        {
            _selectedGenre = SceneGenreCatalog.DefaultGenreId;
            _sceneLocationText = SceneGenreCatalog.DefaultSceneFor(_selectedGenre);
        }

        if (string.IsNullOrEmpty(_sceneImagePath))
        {
            _ = AutoEnsureSceneArtworkAsync();
        }
    }

    public void Dispose()
    {
        ControlContext.OnUIUpdated -= OnBackgroundAutoRefresh;
        ControlContext.OnSettingsChanged -= OnSettingsUpdated;
        SimHost.OnDialogueLine -= OnHostDialogueLine;
        SimHost.OnLog -= OnHostLog;
        SimHost.OnFeedClear -= OnHostFeedClear;
    }

    private void OnHostDialogueLine(DialogueLine line)
    {
        InvokeAsync(() =>
        {
            _dialogueFeed.Add(new ChatMessageModel
            {
                SpeakerName = line.SpeakerName,
                TargetName = line.TargetName,
                Dialogue = line.Dialogue,
                SomaticText = line.SomaticText,
                BondDeltaText = line.BondDeltaText,
                SpeakerEmotionEmoji = line.SpeakerEmotionEmoji,
                SpeakerColor = line.SpeakerColor,
                IsLeft = line.IsLeft,
                IsSystem = line.IsSystem
            });
            RequestScrollPanels();
            StateHasChanged();
        });
    }

    private void OnHostLog(string message)
    {
        if (string.IsNullOrWhiteSpace(message)) return;
        InvokeAsync(() =>
        {
            string level = "log-info";
            if (message.Contains("ERROR", StringComparison.OrdinalIgnoreCase)
                || message.Contains("Failed", StringComparison.OrdinalIgnoreCase))
                level = "log-error";
            else if (message.Contains("⚠") || message.Contains("warn", StringComparison.OrdinalIgnoreCase))
                level = "log-warning";
            else if (message.Contains("SUCCESS", StringComparison.OrdinalIgnoreCase)
                     || message.StartsWith("▶")
                     || message.StartsWith("🎬"))
                level = "log-success";

            _outputLogs.Add(new LogEntryModel
            {
                Timestamp = DateTime.Now,
                Message = message.Length > 2000 ? message[..2000] + "…" : message,
                LevelClass = level
            });
            // Cap log growth
            if (_outputLogs.Count > 500)
                _outputLogs.RemoveRange(0, _outputLogs.Count - 400);
            RequestScrollPanels();
            StateHasChanged();
        });
    }

    private void OnHostFeedClear()
    {
        InvokeAsync(() =>
        {
            _dialogueFeed.Clear();
            RequestScrollPanels();
            StateHasChanged();
        });
    }

    private void RequestScrollPanels() => _pendingScrollPanels = true;

    private void SwitchCenterTab(string tab)
    {
        _centerTab = tab;
        RequestScrollPanels();
    }

    /// <summary>Scroll dialogue + system log after DOM is committed.</summary>
    private async Task ScrollPanelsToBottomAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("scrollPanelsToBottom",
                new[] { "dialogueFeed", "outputLogBox", "historyLogBox" });
        }
        catch
        {
            // WebView may not be ready yet
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        bool dialogueGrew = _dialogueFeed.Count != _lastScrolledDialogueCount;
        bool logGrew = _outputLogs.Count != _lastScrolledLogCount;

        if (_pendingScrollPanels || dialogueGrew || logGrew || firstRender)
        {
            _pendingScrollPanels = false;
            _lastScrolledDialogueCount = _dialogueFeed.Count;
            _lastScrolledLogCount = _outputLogs.Count;
            await ScrollPanelsToBottomAsync();
        }
    }

    private void OnSettingsUpdated(AppSettings settings)
    {
        InvokeAsync(() =>
        {
            try
            {
                if (!_suppressScenePersist)
                    HydrateSceneFieldsFromSettings(settings);

                _outputLogs.Add(new LogEntryModel
                {
                    Timestamp = DateTime.Now,
                    Message = $"⚙️ Engine Settings Active — Roleplay: {settings.RoleplayLlmProvider} ({settings.RoleplayModelIdentifier}) | Image: {settings.ImageEngine} ({settings.ImageResolution}) | Mode: {settings.RoleplayMode} | Scene: [{SceneGenreCatalog.GetById(settings.SelectedGenre).DisplayName}]",
                    LevelClass = "log-info"
                });
                RequestScrollPanels();
            }
            catch (Exception ex)
            {
                _outputLogs.Add(new LogEntryModel
                {
                    Timestamp = DateTime.Now,
                    Message = $"⚙️ Settings update error: {ex.Message}",
                    LevelClass = "log-error"
                });
            }
            StateHasChanged();
        });
    }

    private void OnBackgroundAutoRefresh()
    {
        InvokeAsync(async () =>
        {
            try
            {
                var catalog = CharacterCatalog.ListCardsFresh();
                _characterDropdownOptions = new List<CustomSelect.DropdownOption>
                {
                    new("", "(No Character Selected)")
                };
                foreach (var card in catalog)
                {
                    _characterDropdownOptions.Add(new(card.FileName, card.DisplayName));
                }

                // Prefer settings (setup may have changed SelectedCharA) then current stage.
                string? desired = ControlContext.CurrentSettings?.SelectedCharA;
                if (string.IsNullOrWhiteSpace(desired)
                    || desired.StartsWith("None", StringComparison.OrdinalIgnoreCase))
                {
                    desired = _selectedCharFile;
                }

                bool desiredExists = !string.IsNullOrWhiteSpace(desired)
                    && catalog.Any(c => c.FileName == desired);

                if (desiredExists)
                {
                    // Only load when the staged file actually changed — never re-enter same card.
                    if (!string.Equals(_selectedCharFile, desired, StringComparison.Ordinal)
                        || !_isCharacterLoaded)
                    {
                        await SelectCharacter(desired!, autoPlay: false);
                    }
                }
                else if (_isCharacterLoaded || !string.IsNullOrEmpty(_selectedCharFile))
                {
                    // Card removed from disk / none selected — clear stage quietly.
                    ClearCharacter();
                }

                _outputLogs.Add(new LogEntryModel
                {
                    Timestamp = DateTime.Now,
                    Message = "🔄 Complete UI refresh executed. Re-scanned character cards and configuration from disk.",
                    LevelClass = "log-success"
                });
            }
            catch (Exception ex)
            {
                _outputLogs.Add(new LogEntryModel
                {
                    Timestamp = DateTime.Now,
                    Message = $"🔄 UI refresh failed: {ex.Message}",
                    LevelClass = "log-error"
                });
                // Ensure dropdown has at least the empty option
                _characterDropdownOptions = new List<CustomSelect.DropdownOption>
                {
                    new("", "(No Character Selected)")
                };
            }

            RequestScrollPanels();
            StateHasChanged();
        });
    }

