@page "/"
@inject TurnControlContext ControlContext
@inject IJSRuntime JS

<div class="workspace-grid">
    
    <!-- LEFT PANEL: CHARACTER A -->
    <div class="character-panel">
        <div class="portrait-container">
            @if (!string.IsNullOrEmpty(_charAAvatarPath) && System.IO.File.Exists(_charAAvatarPath))
            {
                <img class="portrait-img" src="@_charAAvatarPath" alt="@_charAName" />
            }
            else
            {
                <div class="canvas-fallback">
                    <div class="canvas-avatar-icon">👤</div>
                    <div class="canvas-char-name">@_charAName</div>
                    <div class="canvas-bio">@_charABio</div>
                </div>
            }
        </div>

        <!-- TELEMETRY METERS -->
        <div class="telemetry-section">
            <div class="meter-group">
                <div class="meter-header">
                    <span>STRESS TELEMETRY</span>
                    <span style="color: var(--accent-amber);">@_charAStress / 100</span>
                </div>
                <div class="meter-bar">
                    <div class="meter-fill-stress" style="width: @(_charAStress)%"></div>
                </div>
            </div>
            <div class="meter-group">
                <div class="meter-header">
                    <span>AROUSAL TELEMETRY</span>
                    <span style="color: var(--accent-purple);">@_charAArousal / 100</span>
                </div>
                <div class="meter-bar">
                    <div class="meter-fill-arousal" style="width: @(_charAArousal)%"></div>
                </div>
            </div>
        </div>

        <!-- GOALS -->
        <div>
            <div class="section-title">
                <span>🎯</span>
                <span>ACTIVE GOALS</span>
            </div>
            <div class="goals-list">
                @if (_charAGoals.Count == 0)
                {
                    <div style="font-size: 0.72rem; color: var(--text-muted); font-style: italic;">No active goals assigned</div>
                }
                else
                {
                    @foreach (var g in _charAGoals)
                    {
                        <div class="goal-card">
                            <div class="goal-name">@g.Name</div>
                            <div class="goal-desc">@g.Description</div>
                        </div>
                    }
                }
            </div>
        </div>

        <!-- ACTIVE SKILLS -->
        <div>
            <div class="section-title">
                <span>⚡</span>
                <span>ACTIVE SKILLS & STANCES</span>
            </div>
            <div class="tags-cloud">
                @if (_charASkills.Count == 0)
                {
                    <span style="font-size: 0.72rem; color: var(--text-muted); font-style: italic;">None</span>
                }
                else
                {
                    @foreach (var s in _charASkills)
                    {
                        <span class="tag-chip">@s</span>
                    }
                }
            </div>
        </div>
    </div>

    <!-- CENTER PANEL: DIALOGUE FEED -->
    <div class="feed-panel">
        <div class="feed-messages" id="dialogueFeed">
            @foreach (var msg in _dialogueFeed)
            {
                <div class="chat-bubble @(msg.IsSystem ? "chat-system" : (msg.IsLeft ? "chat-left" : "chat-right"))">
                    @if (!msg.IsSystem)
                    {
                        <div class="chat-header">
                            <span class="speaker-name" style="color: @msg.SpeakerColor;">@msg.SpeakerName ➔ @msg.TargetName</span>
                            <span>@msg.SpeakerEmotionEmoji</span>
                        </div>
                        @if (!string.IsNullOrEmpty(msg.SomaticText))
                        {
                            <div class="somatic-tag">*@msg.SomaticText*</div>
                        }
                    }
                    <div class="dialogue-text">@msg.Dialogue</div>
                    @if (!string.IsNullOrEmpty(msg.BondDeltaText))
                    {
                        <div class="bond-badge">🔗 Bond Shift: @msg.BondDeltaText</div>
                    }
                </div>
            }
        </div>

        <!-- PLAYER PROMPT INPUT -->
        <div class="player-input-bar">
            <input class="input-box" placeholder="Type prompt or command (e.g. /step, /adult)..." @bind="_playerInput" @bind:event="oninput" @onkeyup="OnPlayerInputKeyUp" />
            <button class="btn btn-primary" @onclick="SendPlayerInput">Send ➔</button>
        </div>
    </div>

    <!-- RIGHT PANEL: CHARACTER B -->
    <div class="character-panel character-panel-right">
        <div class="portrait-container">
            @if (!string.IsNullOrEmpty(_charBAvatarPath) && System.IO.File.Exists(_charBAvatarPath))
            {
                <img class="portrait-img" src="@_charBAvatarPath" alt="@_charBName" />
            }
            else
            {
                <div class="canvas-fallback">
                    <div class="canvas-avatar-icon">👤</div>
                    <div class="canvas-char-name">@_charBName</div>
                    <div class="canvas-bio">@_charBBio</div>
                </div>
            }
        </div>

        <!-- TELEMETRY METERS -->
        <div class="telemetry-section">
            <div class="meter-group">
                <div class="meter-header">
                    <span>STRESS TELEMETRY</span>
                    <span style="color: var(--accent-amber);">@_charBStress / 100</span>
                </div>
                <div class="meter-bar">
                    <div class="meter-fill-stress" style="width: @(_charBStress)%"></div>
                </div>
            </div>
            <div class="meter-group">
                <div class="meter-header">
                    <span>AROUSAL TELEMETRY</span>
                    <span style="color: var(--accent-purple);">@_charBArousal / 100</span>
                </div>
                <div class="meter-bar">
                    <div class="meter-fill-arousal" style="width: @(_charBArousal)%"></div>
                </div>
            </div>
        </div>

        <!-- GOALS -->
        <div>
            <div class="section-title">
                <span>🎯</span>
                <span>ACTIVE GOALS</span>
            </div>
            <div class="goals-list">
                @if (_charBGoals.Count == 0)
                {
                    <div style="font-size: 0.72rem; color: var(--text-muted); font-style: italic;">No active goals assigned</div>
                }
                else
                {
                    @foreach (var g in _charBGoals)
                    {
                        <div class="goal-card">
                            <div class="goal-name">@g.Name</div>
                            <div class="goal-desc">@g.Description</div>
                        </div>
                    }
                }
            </div>
        </div>

        <!-- ACTIVE SKILLS -->
        <div>
            <div class="section-title">
                <span>⚡</span>
                <span>ACTIVE SKILLS & STANCES</span>
            </div>
            <div class="tags-cloud">
                @if (_charBSkills.Count == 0)
                {
                    <span style="font-size: 0.72rem; color: var(--text-muted); font-style: italic;">None</span>
                }
                else
                {
                    @foreach (var s in _charBSkills)
                    {
                        <span class="tag-chip">@s</span>
                    }
                }
            </div>
        </div>
    </div>

</div>

@implements IDisposable

@code {
    private string _charAName = "(No Character Selected)";
    private string _charABio = "No character card assigned to Slot A. Open File ➔ Simulation Setup to select a character.";
    private string _charAAvatarPath = "";
    private int _charAStress = 0;
    private int _charAArousal = 0;
    private List<GoalItem> _charAGoals = new();
    private List<string> _charASkills = new();

    private string _charBName = "(No Character Selected)";
    private string _charBBio = "No character card assigned to Slot B. Open File ➔ Simulation Setup to select a character.";
    private string _charBAvatarPath = "";
    private int _charBStress = 0;
    private int _charBArousal = 0;
    private List<GoalItem> _charBGoals = new();
    private List<string> _charBSkills = new();

    private string _playerInput = "";
    private List<ChatMessageModel> _dialogueFeed = new()
    {
        new ChatMessageModel { SpeakerName = "System", Dialogue = "Stage initialized (No Characters Loaded). Open File ➔ Simulation Setup to assign characters.", IsSystem = true }
    };

    protected override void OnInitialized()
    {
        ControlContext.OnUIUpdated += OnBackgroundAutoRefresh;
    }

    public void Dispose()
    {
        ControlContext.OnUIUpdated -= OnBackgroundAutoRefresh;
    }

    private void OnBackgroundAutoRefresh()
    {
        InvokeAsync(() =>
        {
            StateHasChanged();
            _ = JS.InvokeVoidAsync("scrollFeedToBottom", "dialogueFeed");
        });
    }

    private void OnPlayerInputKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            SendPlayerInput();
        }
    }

    private void SendPlayerInput()
    {
        if (string.IsNullOrWhiteSpace(_playerInput)) return;

        _dialogueFeed.Add(new ChatMessageModel
        {
            SpeakerName = "Player",
            TargetName = "All",
            Dialogue = _playerInput,
            SpeakerColor = "#34D399",
            IsLeft = true,
            SpeakerEmotionEmoji = "💬"
        });

        _playerInput = "";
        InvokeAsync(async () =>
        {
            StateHasChanged();
            await JS.InvokeVoidAsync("scrollFeedToBottom", "dialogueFeed");
        });
    }

    public record GoalItem(string Name, string Description);

    public class ChatMessageModel
    {
        public string SpeakerName { get; set; } = "";
        public string TargetName { get; set; } = "";
        public string Dialogue { get; set; } = "";
        public string SomaticText { get; set; } = "";
        public string BondDeltaText { get; set; } = "";
        public string SpeakerEmotionEmoji { get; set; } = "💬";
        public string SpeakerColor { get; set; } = "#38BDF8";
        public bool IsLeft { get; set; } = true;
        public bool IsSystem { get; set; } = false;
    }
}
