    private void OnPlayerInputKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            SendPlayerInput();
        }
    }

    private void SendPlayerInput()
    {
        if (string.IsNullOrWhiteSpace(_playerInput)) return;

        string line = _playerInput;
        _playerInput = "";
        // Host posts the player bubble (and character replies / command results) via OnDialogueLine.
        SimHost.SubmitPlayerLine(line);
        RequestScrollPanels();
        StateHasChanged();
    }

    private void ClearLogs()
    {
        _outputLogs.Clear();
        _outputLogs.Add(new LogEntryModel { Timestamp = DateTime.Now, Message = "Log cleared by user.", LevelClass = "log-info" });
        RequestScrollPanels();
    }

    private void SaveSelectedCharacter(string fileName)
    {
        try
        {
            // Quiet patch only — UpdateSettings would raise OnUIUpdated and re-enter load.
            ControlContext.PatchSelectedCharacter(fileName);
        }
        catch (Exception ex)
        {
            _outputLogs.Add(new LogEntryModel
            {
                Timestamp = DateTime.Now,
                Message = $"Failed to save selected character: {ex.Message}",
                LevelClass = "log-error"
            });
        }
    }

